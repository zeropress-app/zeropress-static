msgstr "発行する WordPress のクラシックメニューを選択してください。メニュー ID によって、選択したメニューを静的サイトのテーマに対応付けます。"

msgid "Set <strong>Contents</strong> to <strong>Read and write</strong>."
msgstr "<strong>Contents</strong> の権限を <strong>Read and write</strong> に設定してください。"

msgid "Set up a WXR starter repository"
msgstr "WXR スターターリポジトリを準備"

msgid "Settings"
msgstr "設定"

msgid "Settings changed in another window. Reload before saving."
msgstr "別の画面で設定が変更されました。再読み込みしてから保存してください。"

msgid "Settings sections"
msgstr "設定セクション"

msgid "Settings take effect immediately after saving."
msgstr "設定は保存後すぐに適用されます。"

msgid "Show WordPress comments on the static site"
msgstr "静的サイトに WordPress のコメントを表示"

msgid "Show ZeroPress attribution"
msgstr "ZeroPress のクレジットを表示"

