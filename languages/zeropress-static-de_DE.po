msgstr "Beispiel für ein Quell-URL-Präfix:"

msgid "Split XML"
msgstr "Aufgeteilte XML-Dateien"

msgid "Split XML files: {parts}"
msgstr "Aufgeteilte XML-Dateien: {parts}"

msgid "Splits WXR files larger than 8 MiB, or when required by upload size or server memory. Existing split files stay split."
msgstr "Teilt WXR-Dateien über 8 MiB auf, oder wenn Uploadgröße oder Serverarbeitsspeicher dies erfordern. Bereits aufgeteilte Dateien bleiben aufgeteilt."

msgid "Started"
msgstr "Gestartet"

