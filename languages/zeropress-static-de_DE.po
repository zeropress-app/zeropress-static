msgstr "{count} Beiträge oder Seiten haben Inhalte von mindestens 256 KiB (Maximum: {bytes} UTF-8-Bytes). Erwäge, sie in kleinere Beiträge aufzuteilen. Beispiel-IDs: {ids}."

msgid "{media}"
msgstr "{media}"

msgid "{percent}% of {limit}"
msgstr "{percent}% von {limit}"

msgid "{start}–{end} of {total}"
msgstr "{start}–{end} von {total}"
