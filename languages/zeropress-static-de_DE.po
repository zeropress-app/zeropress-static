msgstr "Es sind keine Turnstile-Schlüssel gespeichert. Lade diese Seite neu, um den aktuellen Status zu prüfen."

msgid "No changes to publish."
msgstr "Keine Änderungen zu veröffentlichen."

msgid "Not configured"
msgstr "Nicht eingerichtet"

msgid "Only published posts and pages without a password are exported. Shortcodes and dynamic blocks are not executed."
msgstr "Nur veröffentlichte Beiträge und Seiten ohne Passwort werden exportiert. Shortcodes und dynamische Blöcke werden nicht ausgeführt."

msgid "Open <strong>Select repositories</strong> and choose only the repository entered in <strong>Publishing GitHub repository URL</strong> above."
msgstr "Öffne <strong>Select repositories</strong> und wähle nur das Repository aus, das oben unter <strong>URL des GitHub-Repositorys für die Veröffentlichung</strong> eingetragen ist."

msgid "Open GitHub publishing"
msgstr "GitHub-Veröffentlichung öffnen"

msgid "Opens the signup page in a new tab."
msgstr "Öffnet die Anmeldeseite in einem neuen Tab."

msgid "Other plugins that use public REST APIs may be affected."
msgstr "Andere Plugins, die öffentliche REST-APIs verwenden, können betroffen sein."

msgid "PHP memory limit: {limit}. Estimated memory required: {estimated}."
msgstr "PHP-Speicherlimit: {limit}. Geschätzter Speicherbedarf: {estimated}."

msgid "PHP time limit: {limit} s. Request budget: {budget} s. Elapsed: {elapsed} s."
msgstr "PHP-Zeitlimit: {limit} s. Anfragebudget: {budget} s. Verstrichen: {elapsed} s."

msgid "Posts per page"
msgstr "Beiträge pro Seite"

msgid "Posts: {posts} · Pages: {pages} · Media: {media} · Menus: {menus}"
msgstr "Beiträge: {posts} · Seiten: {pages} · Medien: {media} · Menüs: {menus}"

