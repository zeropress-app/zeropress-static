msgid "Use an API URL that site visitors can access."
msgstr "Use uma URL de API acessível aos visitantes do site."

msgid "Use primary for the main navigation and footer for footer links. Custom IDs must match the menu IDs used by your theme."
msgstr "Use primary para a navegação principal e footer para os links do rodapé. Os IDs personalizados devem corresponder aos IDs de menu usados pelo seu tema."

msgid "Use unique menu IDs starting with a lowercase letter, followed by lowercase letters, numbers, hyphens or underscores (up to 64 characters)."
msgstr "Use IDs de menu exclusivos que comecem com uma letra minúscula, seguida de letras minúsculas, números, hífens ou sublinhados (até 64 caracteres)."

msgid "Use up to 50 complete source and destination URL pairs."
msgstr "Use até 50 pares completos de URLs de origem e destino."

msgid "Verifying publishing data…"
msgstr "Verificando dados para publicação…"

msgid "Verifying the GitHub publication result…"
msgstr "Verificando o resultado da publicação no GitHub…"

msgid "View commit"
msgstr "Ver commit"

msgid "View on static site"
msgstr "Ver no site estático"

msgid "View saved publishing repository"
msgstr "Ver repositório de publicação salvo"

msgid "Wait for WordPress to finish saving your post."
msgstr "Aguarde o WordPress terminar de salvar o post."

msgid "When unchecked, <code>Disallow: /</code> is written to the static site's <code>robots.txt</code>."
msgstr "Quando desmarcado, <code>Disallow: /</code> é gravado no arquivo <code>robots.txt</code> do site estático."

msgid "When writing is off, only comments are shown. Your existing WordPress comment settings still apply."
msgstr "Quando o envio está desativado, os comentários são apenas exibidos. As configurações de comentários do WordPress continuam em vigor."

msgid "WordPress REST API URL"
msgstr "URL da API REST do WordPress"

msgid "WordPress content changed. Prepare again to include the latest data."
msgstr "O conteúdo do WordPress foi alterado. Prepare os dados novamente para incluir as alterações mais recentes."

msgid "WordPress menu"
msgstr "Menu do WordPress"

msgid "Working…"
msgstr "Processando…"

msgid "ZeroPress"
msgstr "ZeroPress"

msgid "ZeroPress Static"
msgstr "ZeroPress Static"

msgid "ZeroPress Static – Static Site Publisher"
msgstr "ZeroPress Static – Publicador de sites estáticos"

msgid "ZeroPress publish"
msgstr "Publicação com ZeroPress"
