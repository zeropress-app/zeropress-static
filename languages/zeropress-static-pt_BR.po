msgid "(No label)"
msgstr "(Sem rótulo)"

msgid "A GitHub branch rule rejected direct publication. Review the repository rules."
msgstr "Uma regra da branch do GitHub rejeitou a publicação direta. Revise as regras do repositório."

msgid "A GitHub token is already registered. Reload this page to manage it."
msgstr "Já existe um token do GitHub cadastrado. Recarregue esta página para gerenciá-lo."

msgid "A GitHub token is registered."
msgstr "Um token do GitHub está cadastrado."

msgid "A Turnstile Secret Key is registered."
msgstr "Uma chave secreta do Turnstile está cadastrada."

msgid "A post or page exceeds the 4 MiB body limit. Split or shorten its body, then prepare again."
msgstr "O conteúdo de um post ou página excede o limite de 4 MiB. Divida ou reduza o conteúdo e prepare os dados novamente."

msgid "A processing-method change is in progress or was interrupted. Reload settings and save the processing method again before preparing."
msgstr "Uma mudança de método de processamento está em andamento ou foi interrompida. Recarregue as configurações e salve o método novamente antes de preparar."

msgid "A publication is in progress. Continue it here if the previous page was closed."
msgstr "Há uma publicação em andamento. Se você fechou a página anterior, pode continuar aqui."

msgid "A selected WordPress menu is unavailable. Reload settings and select a menu again."
msgstr "Um menu do WordPress selecionado não está disponível. Recarregue as configurações e selecione um menu novamente."

msgid "A source media prefix has conflicting destinations."
msgstr "Um prefixo de origem de mídia tem destinos conflitantes."

msgid "A static site URL is required to generate the feed."
msgstr "É necessário informar a URL do site estático para gerar o feed."

msgid "A target file changed on GitHub. Review the change and prepare again."
msgstr "Um arquivo de destino foi alterado no GitHub. Revise a alteração e prepare os dados novamente."

msgid "API protection"
msgstr "Proteção da API"

msgid "Add custom menu"
msgstr "Adicionar menu personalizado"

msgid "Add replacement"
msgstr "Adicionar substituição"

msgid "Adds <code>&lt;meta name=\"generator\"&gt;</code> to the HTML."
msgstr "Adiciona <code>&lt;meta name=\"generator\"&gt;</code> ao HTML."

msgid "Allow comment writing on the static site"
msgstr "Permitir o envio de comentários no site estático"

msgid "Allow search engines to visit this site"
msgstr "Permitir que mecanismos de busca visitem este site"

msgid "An unfinished publication uses the previous processing method. Resolve it before changing methods. An uncertain result can still be checked."
msgstr "Uma publicação inacabada usa o método anterior. Resolva-a antes de mudar de método. Um resultado incerto ainda pode ser verificado."

msgid "Another publication is in progress."
msgstr "Outra publicação está em andamento."

msgid "Apple touch icon"
msgstr "Ícone de toque da Apple"

msgid "Applying changes on GitHub…"
msgstr "Aplicando alterações no GitHub…"

msgid "Approval expired. Cancel this publication and prepare the data again."
msgstr "A autorização expirou. Cancele esta publicação e prepare os dados novamente."

msgid "Authenticated encryption is unavailable. Enable OpenSSL AES-256-GCM on the server before registering credentials."
msgstr "A criptografia autenticada não está disponível. Ative o OpenSSL AES-256-GCM no servidor antes de cadastrar credenciais."

msgid "Automatic"
msgstr "Automático"

msgid "Build settings"
msgstr "Configurações de compilação"

msgid "Button label"
msgstr "Texto do botão"

msgid "Cancel"
msgstr "Cancelar"

msgid "Cancel publication"
msgstr "Cancelar publicação"

msgid "Cancellation requested. Waiting for the current request to finish."
msgstr "Cancelamento solicitado. Aguardando a conclusão da solicitação atual."

msgid "Cancelling publication…"
msgstr "Cancelando a publicação…"

msgid "Change keys"
msgstr "Alterar chaves"

msgid "Check publication result"
msgstr "Verificar resultado"

msgid "Check the values in this section."
msgstr "Verifique os valores desta seção."

msgid "Checking publication status…"
msgstr "Verificando o status da publicação…"

msgid "Checking the GitHub repository…"
msgstr "Verificando o repositório GitHub…"

msgid "Choose how to process publishing data."
msgstr "Escolha como processar os dados de publicação."

msgid "Click “Save publishing target” to save these changes."
msgstr "Clique em “Salvar destino da publicação” para salvar essas alterações."

msgid "Client-supplied REST route overrides are disabled."
msgstr "A substituição de rotas REST pelo cliente está desativada."

msgid "Close"
msgstr "Fechar"

msgid "Close confirmation"
msgstr "Fechar confirmação"

msgid "Cloudflare Privacy Policy"
msgstr "Política de privacidade da Cloudflare"

msgid "Cloudflare Turnstile"
msgstr "Cloudflare Turnstile"

msgid "Cloudflare Turnstile (optional)"
msgstr "Cloudflare Turnstile (opcional)"

msgid "Cloudflare Turnstile can help reduce automated comment submission attacks."
msgstr "O Cloudflare Turnstile pode ajudar a reduzir ataques de envio automatizado de comentários."

msgid "Comment display and writing"
msgstr "Exibição e envio de comentários"

msgid "Comment request limiting is temporarily unavailable. Please try again later."
msgstr "A limitação de solicitações de comentários está temporariamente indisponível. Tente novamente mais tarde."

msgid "Comment writing could not be verified. Refresh the writing options and try again."
msgstr "Não foi possível verificar o envio do comentário. Atualize as opções de envio e tente novamente."

msgid "Comments"
msgstr "Comentários"

msgid "Connection details changed. Test again to check these values."
msgstr "Os dados de conexão foram alterados. Teste a conexão novamente para verificar esses valores."

msgid "Content"
msgstr "Conteúdo"

msgid "Continue publication"
msgstr "Continuar publicação"

msgid "Create a GitHub token"
msgstr "Criar um token do GitHub"

msgid "Delete saved keys"
msgstr "Excluir chaves salvas"

msgid "Delete saved token"
msgstr "Excluir token salvo"

msgid "Delete the saved GitHub token?"
msgstr "Excluir o token do GitHub salvo?"

msgid "Delete the saved Site Key and Secret Key and turn off Cloudflare Turnstile."
msgstr "Exclua a chave do site e a chave secreta salvas e desative o Cloudflare Turnstile."

msgid "Delete the saved Turnstile keys?"
msgstr "Excluir as chaves do Turnstile salvas?"

msgid "Delete token"
msgstr "Excluir token"

msgid "Deleting keys…"
msgstr "Excluindo chaves…"

msgid "Deleting token…"
msgstr "Excluindo token…"

msgid "Description"
msgstr "Descrição"

msgid "Destination URL prefix"
msgstr "Prefixo da URL de destino"

msgid "Destination URL prefix example:"
msgstr "Exemplo de prefixo da URL de destino:"

msgid "Destination will be determined during the site build."
msgstr "O destino será determinado durante a geração do site."

msgid "Destinations use your saved site settings. Preparation excludes unavailable or non-public items."
msgstr "Os destinos usam as configurações salvas do site. A preparação exclui itens indisponíveis ou não públicos."

msgid "Display and credits"
msgstr "Exibição e créditos"

msgid "Displays <code>Published with ZeroPress</code> in the theme footer."
msgstr "Exibe <code>Published with ZeroPress</code> no rodapé do tema."

msgid "Displays the signup page in a popup on your site. Use a page URL that allows iframe embedding."
msgstr "Exibe a página de inscrição em um pop-up no seu site. Use a URL de uma página que permita incorporação por iframe."

msgid "Download WXR"
msgstr "Baixar WXR"

msgid "Download build settings"
msgstr "Baixar configurações de compilação"

msgid "Download sizes; media files are not included."
msgstr "Tamanhos dos downloads; arquivos de mídia não estão incluídos."

msgid "Downloads"
msgstr "Downloads"

msgid "Downloads ready. Connect GitHub and prepare again to check publishing."
msgstr "Os downloads estão prontos. Conecte o GitHub e prepare os dados novamente para verificar se é possível publicar."

msgid "Downloads ready; publishing blocked."
msgstr "Downloads prontos; publicação bloqueada."

msgid "Edit in WordPress"
msgstr "Editar no WordPress"

msgid "Edit in WordPress settings"
msgstr "Editar nas configurações do WordPress"

msgid "Edit publishing settings"
msgstr "Editar configurações de publicação"

msgid "Embedded signup page URL"
msgstr "URL da página de inscrição incorporada"

msgid "Enable JavaScript to save settings and prepare publishing data."
msgstr "Ative o JavaScript para salvar as configurações e preparar os dados para publicação."

msgid "Enable search on the static site"
msgstr "Ativar a busca no site estático"

msgid "Enter Turnstile keys without spaces or line breaks."
msgstr "Digite as chaves do Turnstile sem espaços ou quebras de linha."

msgid "Enter a GitHub repository before testing the connection."
msgstr "Informe um repositório GitHub antes de testar a conexão."

msgid "Enter a REST API URL that site visitors can access to enable comments."
msgstr "Digite uma URL da API REST acessível aos visitantes do site para ativar os comentários."

msgid "Enter a Secret Key without spaces or line breaks."
msgstr "Digite uma chave secreta sem espaços ou quebras de linha."

msgid "Enter a Turnstile Site Key."
msgstr "Digite uma chave do site do Turnstile."

msgid "Enter a button label of up to 200 characters."
msgstr "Digite um texto de botão de até 200 caracteres."

msgid "Enter a description of up to 2,000 characters."
msgstr "Digite uma descrição de até 2.000 caracteres."

msgid "Enter a github.com repository URL or owner/repository."
msgstr "Digite a URL de um repositório do github.com ou proprietário/repositório."

msgid "Enter a signup page URL or an embedded signup page URL."
msgstr "Digite a URL de uma página de inscrição ou de uma página de inscrição incorporada."

msgid "Enter a title of up to 200 characters."
msgstr "Digite um título de até 200 caracteres."

msgid "Enter a token without spaces or line breaks."
msgstr "Digite um token sem espaços ou quebras de linha."

msgid "Enter a valid HTTP(S) embedded signup page URL or site-relative path (up to 2,048 characters)."
msgstr "Digite uma URL HTTP(S) válida de página de inscrição incorporada ou um caminho relativo ao site (até 2.048 caracteres)."

msgid "Enter a valid HTTP(S) signup page URL or site-relative path (up to 2,048 characters)."
msgstr "Digite uma URL HTTP(S) válida de página de inscrição ou um caminho relativo ao site (até 2.048 caracteres)."

msgid "Enter a whole number of at least 1 for posts per page."
msgstr "Informe um número inteiro maior ou igual a 1 para os posts por página."

msgid "Enter an HTTP(S) URL without credentials, a query or a fragment."
msgstr "Digite uma URL HTTP(S) sem credenciais, parâmetros de consulta ou fragmentos."

msgid "Enter an HTTP(S) page URL or a path starting with <code>/</code>. At least one of the two URLs is required."
msgstr "Digite uma URL de página HTTP(S) ou um caminho que comece com <code>/</code>. Pelo menos uma das duas URLs é necessária."

msgid "Enter the Secret Key for this Site Key."
msgstr "Digite a chave secreta correspondente a esta chave do site."

msgid "Enter the publishing branch name. Tags and commit URLs are not supported."
msgstr "Digite o nome da branch de publicação. Tags e URLs de commits não são aceitas."

msgid "Enter the site origin without a path."
msgstr "Digite a origem do site sem um caminho."

msgid "Example based on this WordPress installation: %s."
msgstr "Exemplo baseado nesta instalação do WordPress: %s."

msgid "Examples: %1$s · %2$s"
msgstr "Exemplos: %1$s · %2$s"

msgid "External services handle data under their own privacy policies."
msgstr "Os serviços externos tratam os dados de acordo com suas próprias políticas de privacidade."

msgid "Featured image"
msgstr "Imagem destacada"

msgid "Files (recommended)"
msgstr "Arquivos (recomendado)"

msgid "Files to update"
msgstr "Arquivos a atualizar"

msgid "Files: uses private temporary files to process large amounts of publishing data and supports pausing and continuing publication."
msgstr "Arquivos: usa arquivos temporários privados para processar grandes volumes de dados de publicação e permite pausar e continuar a publicação."

msgid "Finish or cancel the current publication before changing methods. If its result is uncertain, check the result first."
msgstr "Conclua ou cancele a publicação atual antes de mudar de método. Se o resultado for incerto, verifique-o primeiro."

msgid "Footer text and ZeroPress attribution depend on theme support."
msgstr "A exibição do texto do rodapé e da atribuição do ZeroPress depende do suporte do tema."

msgid "Generate RSS feed"
msgstr "Gerar feed RSS"

msgid "Generate chronological archives"
msgstr "Gerar arquivos cronológicos"

msgid "Get new posts and updates by email."
msgstr "Receba novos posts e atualizações por e-mail."

msgid "Get the latest news by email"
msgstr "Receba as últimas novidades por e-mail"

msgid "GitHub"
msgstr "GitHub"

msgid "GitHub Privacy Statement"
msgstr "Declaração de privacidade do GitHub"

msgid "GitHub already contains this data. You do not need to publish again."
msgstr "Esses dados já estão no GitHub. Não é necessário publicar novamente."

msgid "GitHub connection confirmed."
msgstr "Conexão com o GitHub confirmada."

msgid "GitHub connection required"
msgstr "Conexão com o GitHub necessária"

msgid "GitHub did not accept the registered token. Delete it and register a token again, then test the connection."
msgstr "O GitHub não aceitou o token cadastrado. Exclua-o, cadastre um token novamente e teste a conexão."

msgid "GitHub did not return a recognized repository visibility. Check the connection and prepare again."
msgstr "O GitHub não retornou uma visibilidade de repositório reconhecida. Verifique a conexão e prepare novamente."

msgid "GitHub is temporarily unavailable or the request timed out."
msgstr "O GitHub está temporariamente indisponível ou a solicitação excedeu o tempo limite."

msgid "GitHub publishing"
msgstr "Publicação no GitHub"

msgid "GitHub publishing (optional)"
msgstr "Publicação no GitHub (opcional)"

msgid "GitHub rejected an oversized file or request. Review unusually large content or metadata before preparing again."
msgstr "O GitHub rejeitou um arquivo ou uma solicitação grande demais. Revise conteúdos ou metadados excepcionalmente grandes antes de preparar novamente."

msgid "GitHub rejected the write. Check repository permissions and branch rules."
msgstr "O GitHub rejeitou a gravação. Verifique as permissões do repositório e as regras da branch."

msgid "GitHub repository"
msgstr "Repositório GitHub"

msgid "GitHub request limit reached. Wait before trying again."
msgstr "O limite de solicitações do GitHub foi atingido. Aguarde antes de tentar novamente."

msgid "GitHub token"
msgstr "Token do GitHub"

msgid "GitHub token management"
msgstr "Gerenciamento do token do GitHub"

msgid "GitHub tokens and Turnstile secret keys are stored encrypted in WordPress."
msgstr "Os tokens do GitHub e as chaves secretas do Turnstile são armazenados de forma criptografada no WordPress."

msgid "Icon URLs for publishing"
msgstr "URLs dos ícones para publicação"

msgid "If you connect GitHub, the plugin contacts it when you test the connection, prepare data or publish. Publishing sends public content and site settings to your selected repository."
msgstr "Se você conectar o GitHub, o plugin se comunica com ele ao testar a conexão, preparar os dados ou publicar. A publicação envia o conteúdo público e as configurações do site ao repositório selecionado."

msgid "If you connect a newsletter signup page, visitors contact that service when they open or view it on your site. The service handles their subscription information."
msgstr "Se você conectar uma página de inscrição em uma newsletter, os visitantes se conectam a esse serviço ao abri-la ou visualizá-la no seu site. O serviço trata as informações de inscrição deles."

msgid "Information from WordPress"
msgstr "Informações do WordPress"

msgid "Internal"
msgstr "Interno"

msgid "Items: {count}"
msgstr "Itens: {count}"

msgid "JSON file"
msgstr "Arquivo JSON"

msgid "Learn more (English)"
msgstr "Saiba mais (em inglês)"

msgid "Learn more about API protection"
msgstr "Saiba mais sobre a proteção da API"

msgid "Learn more about publishing data processing"
msgstr "Saiba mais sobre o processamento dos dados de publicação"

msgid "Leave blank to hide this text."
msgstr "Deixe em branco para ocultar este texto."

msgid "Leave blank to skip generating the sitemap and RSS feed."
msgstr "Deixe em branco para não gerar o mapa do site nem o feed RSS."

msgid "Leave the title, description and button label blank to use the theme defaults."
msgstr "Deixe o título, a descrição e o texto do botão em branco para usar os padrões do tema."

msgid "Loading details…"
msgstr "Carregando detalhes…"

msgid "Manage Cloudflare Turnstile"
msgstr "Gerenciar Cloudflare Turnstile"

msgid "Media URL reference"
msgstr "Referência de URL de mídia"

