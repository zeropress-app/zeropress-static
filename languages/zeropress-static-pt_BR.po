msgstr "Nenhum token do GitHub está cadastrado. Recarregue esta página para verificar o status atual."

msgid "No Turnstile keys are saved. Reload this page to check their current status."
msgstr "Nenhuma chave do Turnstile está salva. Recarregue esta página para verificar o status atual."

msgid "No changes to publish."
msgstr "Não há alterações para publicar."

msgid "No items to show."
msgstr "Nenhum item para exibir."

msgid "Not configured"
msgstr "Não configurado"

