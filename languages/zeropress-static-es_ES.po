msgstr "Activa JavaScript para guardar los ajustes y preparar los datos para publicar."

msgid "Enable search"
msgstr "Activar búsqueda"

msgid "Enter Turnstile keys without spaces or line breaks."
msgstr "Introduce las claves de Turnstile sin espacios ni saltos de línea."

msgid "Enter a GitHub repository before testing the connection."
msgstr "Introduce un repositorio de GitHub antes de probar la conexión."

msgid "Enter a REST API URL that site visitors can access to enable comments."
msgstr "Introduce una URL de la API REST accesible para los visitantes del sitio para activar los comentarios."

msgid "Enter a Secret Key without spaces or line breaks."
msgstr "Introduce una clave secreta sin espacios ni saltos de línea."

msgid "Enter a Turnstile Site Key."
msgstr "Introduce una clave del sitio de Turnstile."

msgid "Enter a button label of up to 200 characters."
msgstr "Introduce una etiqueta de botón de hasta 200 caracteres."

msgid "Enter a description of up to 2,000 characters."
msgstr "Introduce una descripción de hasta 2.000 caracteres."

msgid "Enter a github.com repository URL or owner/repository."
msgstr "Introduce la URL de un repositorio de github.com o propietario/repositorio."

msgid "Enter a signup page URL or an embedded signup page URL."
msgstr "Introduce la URL de una página de suscripción o de una página de suscripción incrustada."

msgid "Enter a static site URL to allow comment writing."
msgstr "Introduce la URL del sitio estático para permitir escribir comentarios."

msgid "Enter a title of up to 200 characters."
msgstr "Introduce un título de hasta 200 caracteres."

msgid "Enter a token without spaces or line breaks."
msgstr "Introduce un token sin espacios ni saltos de línea."

msgid "Enter a valid HTTP(S) embedded signup page URL or site-relative path (up to 2,048 characters)."
msgstr "Introduce una URL HTTP(S) válida de una página de suscripción incrustada o una ruta relativa al sitio (hasta 2.048 caracteres)."

msgid "Enter a valid HTTP(S) signup page URL or site-relative path (up to 2,048 characters)."
msgstr "Introduce una URL HTTP(S) válida de una página de suscripción o una ruta relativa al sitio (hasta 2.048 caracteres)."

msgid "Enter an HTTP(S) URL without credentials, a query or a fragment."
msgstr "Introduce una URL HTTP(S) sin credenciales, parámetros de consulta ni fragmentos."

msgid "Enter an HTTP(S) page URL or a path starting with <code>/</code>. At least one of the two URLs is required."
msgstr "Introduce una URL de página HTTP(S) o una ruta que empiece por <code>/</code>. Se necesita al menos una de las dos URL."

msgid "Enter the Secret Key for this Site Key."
msgstr "Introduce la clave secreta de esta clave del sitio."

msgid "Enter the publishing branch name. Tags and commit URLs are not supported."
msgstr "Introduce el nombre de la rama de publicación. No se admiten etiquetas ni URL de commits."

msgid "Enter the site origin without a path."
msgstr "Introduce el origen del sitio sin una ruta."

msgid "Example based on this WordPress installation: %s."
msgstr "Ejemplo basado en esta instalación de WordPress: %s."

msgid "Examples: %1$s · %2$s · %3$s"
msgstr "Ejemplos: %1$s · %2$s · %3$s"

