msgid "(No label)"
msgstr "(Sin etiqueta)"

msgid "A GitHub branch rule rejected direct publication. Review the repository rules."
msgstr "Una regla de la rama de GitHub ha rechazado la publicación directa. Revisa las reglas del repositorio."

msgid "A GitHub token is already registered. Reload this page to manage it."
msgstr "Ya hay un token de GitHub registrado. Recarga esta página para gestionarlo."

msgid "A GitHub token is registered."
msgstr "Hay un token de GitHub registrado."

msgid "A Turnstile Secret Key is registered."
msgstr "Hay una clave secreta de Turnstile registrada."

msgid "A post or page exceeds the 4 MiB body limit. Split or shorten its body, then prepare again."
msgstr "El contenido de una entrada o página supera el límite de 4 MiB. Divídelo o acórtalo y vuelve a preparar los datos."

msgid "A processing-method change is in progress or was interrupted. Reload settings and save the processing method again before preparing."
msgstr "Hay un cambio de método de procesamiento en curso o interrumpido. Recarga los ajustes y guarda de nuevo el método antes de preparar."

msgid "A publication is in progress. Continue it here if the previous page was closed."
msgstr "Hay una publicación en curso. Si cerraste la página anterior, puedes continuar aquí."

msgid "A selected WordPress menu is unavailable. Reload settings and select a menu again."
msgstr "Un menú de WordPress seleccionado no está disponible. Recarga los ajustes y vuelve a seleccionar un menú."

msgid "A source media prefix has conflicting destinations."
msgstr "Un prefijo de origen de medios tiene destinos incompatibles."

msgid "A static site URL is required to generate the feed."
msgstr "Se necesita la URL del sitio estático para generar el feed."

msgid "A target file changed on GitHub. Review the change and prepare again."
msgstr "Un archivo de destino ha cambiado en GitHub. Revisa el cambio y vuelve a preparar los datos."

msgid "API protection"
msgstr "Protección de la API"

msgid "Add custom menu"
msgstr "Añadir menú personalizado"

msgid "Add replacement"
msgstr "Añadir sustitución"

msgid "Adds <code>&lt;meta name=\"generator\"&gt;</code> to the HTML."
msgstr "Añade <code>&lt;meta name=\"generator\"&gt;</code> al HTML."

msgid "Allow comment writing on the static site"
msgstr "Permitir escribir comentarios en el sitio estático"

msgid "Allow search engines to visit this site"
msgstr "Permitir que los motores de búsqueda visiten este sitio"

msgid "An unfinished publication uses the previous processing method. Resolve it before changing methods. An uncertain result can still be checked."
msgstr "Una publicación sin terminar utiliza el método anterior. Resuélvela antes de cambiar de método. Todavía puedes comprobar un resultado incierto."

msgid "Another publication is in progress."
msgstr "Hay otra publicación en curso."

msgid "Apple touch icon"
msgstr "Icono táctil de Apple"

msgid "Applying changes on GitHub…"
msgstr "Aplicando cambios en GitHub…"

msgid "Approval expired"
msgstr "Aprobación caducada"

msgid "Approval expired. Cancel this publication and prepare the data again."
msgstr "La autorización ha caducado. Cancela esta publicación y prepara los datos de nuevo."

msgid "Authenticated encryption is unavailable. Enable OpenSSL AES-256-GCM on the server before registering credentials."
msgstr "El cifrado autenticado no está disponible. Activa OpenSSL AES-256-GCM en el servidor antes de registrar las credenciales."

msgid "Automatic"
msgstr "Automático"

msgid "Build settings"
msgstr "Configuración de compilación"

