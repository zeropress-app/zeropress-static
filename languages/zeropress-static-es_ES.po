msgstr "Visualización y créditos"

msgid "Displays <code>Published with ZeroPress</code> in the theme footer."
msgstr "Muestra <code>Published with ZeroPress</code> en el pie de página del tema."

msgid "Displays the signup page in a popup on your site. Use a page URL that allows iframe embedding."
msgstr "Muestra la página de suscripción en una ventana emergente de tu sitio. Utiliza la URL de una página que permita incrustarse en un iframe."

msgid "Do not publish"
msgstr "No publicar"

msgid "Download WXR"
msgstr "Descargar WXR"

msgid "Download build settings"
msgstr "Descargar ajustes de compilación"

