msgstr "Project-Id-Version: ZeroPress Static 1.0.0\nContent-Type: text/plain; charset=UTF-8\nLanguage: es_ES\nPlural-Forms: nplurals=2; plural=(n != 1);\n"

msgid "A GitHub branch rule rejected direct publication. Review the repository rules."
msgstr "Una regla de la rama de GitHub ha rechazado la publicación directa. Revisa las reglas del repositorio."

msgid "A GitHub token is already registered. Reload this page to manage it."
msgstr "Ya hay un token de GitHub registrado. Recarga esta página para gestionarlo."

msgid "A GitHub token is registered."
msgstr "Hay un token de GitHub registrado."

msgid "A Turnstile Secret Key is registered."
msgstr "Hay una clave secreta de Turnstile registrada."

msgid "A post or page exceeds the 4 MiB body limit. Split or shorten its body, then prepare again."
msgstr "El contenido de una entrada o página supera el límite de 4 MiB. Divídelo o acórtalo y vuelve a preparar los datos."

msgid "A processing-method change is in progress or was interrupted. Reload settings and save the processing method again before preparing."
msgstr "Hay un cambio de método de procesamiento en curso o interrumpido. Recarga los ajustes y guarda de nuevo el método antes de preparar."

msgid "A publication is in progress. Continue it here if the previous page was closed."
msgstr "Hay una publicación en curso. Si cerraste la página anterior, puedes continuar aquí."

msgid "A selected WordPress menu is unavailable. Reload settings and select a menu again."
msgstr "Un menú de WordPress seleccionado no está disponible. Recarga los ajustes y vuelve a seleccionar un menú."

msgid "A source media prefix has conflicting destinations."
msgstr "Un prefijo de origen de medios tiene destinos incompatibles."

msgid "A static site URL is required to generate the feed."
msgstr "Se necesita la URL del sitio estático para generar el feed."

msgid "A target file changed on GitHub. Review the change and prepare again."
msgstr "Un archivo de destino ha cambiado en GitHub. Revisa el cambio y vuelve a preparar los datos."

msgid "API protection"
msgstr "Protección de la API"

msgid "Add custom menu"
msgstr "Añadir menú personalizado"

msgid "Add replacement"
msgstr "Añadir sustitución"

msgid "Adds <code>&lt;meta name=\"generator\"&gt;</code> to the HTML."
msgstr "Añade <code>&lt;meta name=\"generator\"&gt;</code> al HTML."

msgid "Allow comment writing on the static site"
msgstr "Permitir escribir comentarios en el sitio estático"

msgid "Allow search engine crawling"
msgstr "Permitir el rastreo de los motores de búsqueda"

msgid "An unfinished publication uses the previous processing method. Resolve it before changing methods. An uncertain result can still be checked."
msgstr "Una publicación sin terminar utiliza el método anterior. Resuélvela antes de cambiar de método. Todavía puedes comprobar un resultado incierto."

msgid "Another publication is in progress."
msgstr "Hay otra publicación en curso."

msgid "Apple touch icon"
msgstr "Icono táctil de Apple"

msgid "Applying changes on GitHub…"
msgstr "Aplicando cambios en GitHub…"

msgid "Approval expired. Cancel this publication and prepare the data again."
msgstr "La autorización ha caducado. Cancela esta publicación y prepara los datos de nuevo."

msgid "Authenticated encryption is unavailable. Enable OpenSSL AES-256-GCM on the server before registering credentials."
msgstr "El cifrado autenticado no está disponible. Activa OpenSSL AES-256-GCM en el servidor antes de registrar las credenciales."

msgid "Automatic"
msgstr "Automático"

msgid "Automatic splits WXR files larger than 8 MiB on compatible starters. Smaller files may also be split depending on upload size or server memory. Existing split exports stay split. XML downloads always remain a single file."
msgstr "En los starters compatibles, Automático divide los archivos WXR que superan los 8 MiB. Los archivos más pequeños también pueden dividirse según el tamaño del envío o la memoria del servidor. Las exportaciones ya divididas se mantienen así. Las descargas XML siempre se ofrecen como un único archivo."

msgid "Button label"
msgstr "Etiqueta del botón"

msgid "Cancel"
msgstr "Cancelar"

msgid "Cancel publication"
msgstr "Cancelar publicación"

msgid "Cancellation requested. Waiting for the current request to finish."
msgstr "Se ha solicitado la cancelación. Esperando a que termine la solicitud actual."

msgid "Change keys"
msgstr "Cambiar claves"

msgid "Check publication result"
msgstr "Comprobar resultado"

msgid "Check the values in this section."
msgstr "Comprueba los valores de esta sección."

msgid "Check your GitHub settings before publishing."
msgstr "Comprueba tus ajustes de GitHub antes de publicar."

msgid "Checking the GitHub repository…"
msgstr "Comprobando el repositorio de GitHub…"

msgid "Choose how this WordPress server prepares, downloads and publishes exports. WXR publishing format controls the files sent to GitHub separately."
msgstr "Elige cómo este servidor WordPress prepara, descarga y publica las exportaciones. El formato de publicación WXR controla por separado los archivos enviados a GitHub."

msgid "Click “Save publishing target” to save these changes."
msgstr "Haz clic en «Guardar destino de publicación» para guardar estos cambios."

msgid "Client-supplied REST route overrides are disabled."
msgstr "La redefinición de rutas REST por parte del cliente está desactivada."

msgid "Close"
msgstr "Cerrar"

msgid "Close confirmation"
msgstr "Cerrar confirmación"

msgid "Cloudflare Turnstile"
msgstr "Cloudflare Turnstile"

msgid "Cloudflare Turnstile can help reduce automated comment submission attacks."
msgstr "Cloudflare Turnstile puede ayudar a reducir los ataques de envío automatizado de comentarios."

msgid "Comment display and writing"
msgstr "Visualización y escritura de comentarios"

msgid "Comment request limiting is temporarily unavailable. Please try again later."
msgstr "La limitación de solicitudes de comentarios no está disponible temporalmente. Vuelve a intentarlo más tarde."

msgid "Comment writing could not be verified. Refresh the writing options and try again."
msgstr "No se ha podido verificar el envío del comentario. Actualiza las opciones de escritura y vuelve a intentarlo."

msgid "Comments"
msgstr "Comentarios"

msgid "Connection details changed. Test again to check these values."
msgstr "Los datos de conexión han cambiado. Vuelve a probar la conexión para comprobar estos valores."

msgid "Continue publication"
msgstr "Continuar publicación"

msgid "Copyright or legal notice"
msgstr "Copyright o aviso legal"

msgid "Create a GitHub token"
msgstr "Crear un token de GitHub"

msgid "Data is ready to download. Configure and test GitHub to publish."
msgstr "Los datos están listos para descargar. Configura y prueba la conexión con GitHub para publicar."

msgid "Data prepared. Review the result below."
msgstr "Datos preparados. Revisa el resultado a continuación."

msgid "Delete saved keys"
msgstr "Eliminar claves guardadas"

msgid "Delete saved token"
msgstr "Eliminar token guardado"

msgid "Delete the saved GitHub token?"
msgstr "¿Eliminar el token de GitHub guardado?"

msgid "Delete the saved Site Key and Secret Key and turn off Cloudflare Turnstile."
msgstr "Elimina la clave del sitio y la clave secreta guardadas y desactiva Cloudflare Turnstile."

msgid "Delete the saved Turnstile keys?"
msgstr "¿Eliminar las claves de Turnstile guardadas?"

msgid "Delete token"
msgstr "Eliminar token"

msgid "Deleting keys…"
msgstr "Eliminando claves…"

msgid "Deleting token…"
msgstr "Eliminando token…"

msgid "Description"
msgstr "Descripción"

msgid "Destination URL prefix"
msgstr "Prefijo de URL de destino"

msgid "Destination URL prefix example:"
msgstr "Ejemplo de prefijo de URL de destino:"

msgid "Display and credits"
msgstr "Visualización y créditos"

msgid "Displays <code>Published with ZeroPress</code> in the theme footer."
msgstr "Muestra <code>Published with ZeroPress</code> en el pie de página del tema."

msgid "Displays the signup page in a popup on your site. Use a page URL that allows iframe embedding."
msgstr "Muestra la página de suscripción en una ventana emergente de tu sitio. Utiliza la URL de una página que permita incrustarse en un iframe."

msgid "Do not publish"
msgstr "No publicar"

msgid "Download WXR"
msgstr "Descargar WXR"

msgid "Download build settings"
msgstr "Descargar ajustes de compilación"

msgid "Edit in WordPress settings"
msgstr "Editar en los ajustes de WordPress"

msgid "Edit publishing settings"
msgstr "Editar ajustes de publicación"

msgid "Embedded signup page URL"
msgstr "URL de la página de suscripción incrustada"

msgid "Enable JavaScript to save settings and prepare publishing data."
msgstr "Activa JavaScript para guardar los ajustes y preparar los datos para publicar."

msgid "Enable search"
msgstr "Activar búsqueda"

msgid "Enter Turnstile keys without spaces or line breaks."
msgstr "Introduce las claves de Turnstile sin espacios ni saltos de línea."

msgid "Enter a GitHub repository before testing the connection."
msgstr "Introduce un repositorio de GitHub antes de probar la conexión."

msgid "Enter a REST API URL that site visitors can access to enable comments."
msgstr "Introduce una URL de la API REST accesible para los visitantes del sitio para activar los comentarios."

msgid "Enter a Secret Key without spaces or line breaks."
msgstr "Introduce una clave secreta sin espacios ni saltos de línea."

msgid "Enter a Turnstile Site Key."
msgstr "Introduce una clave del sitio de Turnstile."

msgid "Enter a button label of up to 200 characters."
msgstr "Introduce una etiqueta de botón de hasta 200 caracteres."

msgid "Enter a description of up to 2,000 characters."
msgstr "Introduce una descripción de hasta 2.000 caracteres."

msgid "Enter a github.com repository URL or owner/repository."
msgstr "Introduce la URL de un repositorio de github.com o propietario/repositorio."

msgid "Enter a signup page URL or an embedded signup page URL."
msgstr "Introduce la URL de una página de suscripción o de una página de suscripción incrustada."

msgid "Enter a static site URL to allow comment writing."
msgstr "Introduce la URL del sitio estático para permitir escribir comentarios."

msgid "Enter a title of up to 200 characters."
msgstr "Introduce un título de hasta 200 caracteres."

msgid "Enter a token without spaces or line breaks."
msgstr "Introduce un token sin espacios ni saltos de línea."

msgid "Enter a valid HTTP(S) embedded signup page URL or site-relative path (up to 2,048 characters)."
msgstr "Introduce una URL HTTP(S) válida de una página de suscripción incrustada o una ruta relativa al sitio (hasta 2.048 caracteres)."

msgid "Enter a valid HTTP(S) signup page URL or site-relative path (up to 2,048 characters)."
msgstr "Introduce una URL HTTP(S) válida de una página de suscripción o una ruta relativa al sitio (hasta 2.048 caracteres)."

msgid "Enter an HTTP(S) URL without credentials, a query or a fragment."
msgstr "Introduce una URL HTTP(S) sin credenciales, parámetros de consulta ni fragmentos."

msgid "Enter an HTTP(S) page URL or a path starting with <code>/</code>. At least one of the two URLs is required."
msgstr "Introduce una URL de página HTTP(S) o una ruta que empiece por <code>/</code>. Se necesita al menos una de las dos URL."

msgid "Enter the Secret Key for this Site Key."
msgstr "Introduce la clave secreta de esta clave del sitio."

msgid "Enter the publishing branch name. Tags and commit URLs are not supported."
msgstr "Introduce el nombre de la rama de publicación. No se admiten etiquetas ni URL de commits."

msgid "Enter the site origin without a path."
msgstr "Introduce el origen del sitio sin una ruta."

msgid "Example based on this WordPress installation: %s."
msgstr "Ejemplo basado en esta instalación de WordPress: %s."

msgid "Examples: %1$s · %2$s · %3$s"
msgstr "Ejemplos: %1$s · %2$s · %3$s"

msgid "Export inputs must be regular files, not directories, symlinks or submodules."
msgstr "Las entradas de exportación deben ser archivos normales, no directorios, enlaces simbólicos ni submódulos."

msgid "Export processing"
msgstr "Procesamiento de exportaciones"

msgid "Files to update"
msgstr "Archivos que se actualizarán"

msgid "Finish or cancel the current publication before changing methods. If its result is uncertain, check the result first."
msgstr "Finaliza o cancela la publicación actual antes de cambiar de método. Si el resultado es incierto, compruébalo primero."

msgid "Generate RSS feed"
msgstr "Generar feed RSS"

msgid "Generate chronological archives"
msgstr "Generar archivos cronológicos"

msgid "Get new posts and updates by email."
msgstr "Recibe nuevas entradas y novedades por correo electrónico."

msgid "Get the latest news by email"
msgstr "Recibe las últimas noticias por correo electrónico"

msgid "GitHub already contains this data. You do not need to publish again."
msgstr "GitHub ya contiene estos datos. No es necesario volver a publicar."

msgid "GitHub connection confirmed."
msgstr "Conexión con GitHub confirmada."

msgid "GitHub did not accept the registered token. Delete it and register a token again, then test the connection."
msgstr "GitHub no ha aceptado el token registrado. Elimínalo, registra un token de nuevo y prueba la conexión."

msgid "GitHub did not return a recognized repository visibility. Check the connection and prepare again."
msgstr "GitHub no devolvió una visibilidad de repositorio reconocida. Comprueba la conexión y prepara de nuevo."

msgid "GitHub is temporarily unavailable or the request timed out."
msgstr "GitHub no está disponible temporalmente o se ha agotado el tiempo de espera de la solicitud."

msgid "GitHub publishing"
msgstr "Publicación en GitHub"

msgid "GitHub publishing (optional)"
msgstr "Publicación en GitHub (opcional)"

msgid "GitHub rejected an oversized file or request. Check that your WXR starter supports split exports and review unusually large entries before preparing again."
msgstr "GitHub ha rechazado un archivo o una solicitud demasiado grande. Comprueba que tu plantilla WXR admita exportaciones divididas y revisa las entradas excesivamente grandes antes de volver a preparar los datos."

msgid "GitHub rejected the write. Check repository permissions and branch rules."
msgstr "GitHub ha rechazado la escritura. Comprueba los permisos del repositorio y las reglas de la rama."

msgid "GitHub repository"
msgstr "Repositorio de GitHub"

msgid "GitHub request limit reached. Wait before trying again."
msgstr "Se ha alcanzado el límite de solicitudes de GitHub. Espera antes de volver a intentarlo."

msgid "GitHub token"
msgstr "Token de GitHub"

msgid "GitHub token management"
msgstr "Gestión del token de GitHub"

msgid "Icon URLs for publishing"
msgstr "URL de iconos para publicar"

msgid "Information from WordPress"
msgstr "Información de WordPress"

msgid "Internal"
msgstr "Interno"

msgid "Learn more about API protection"
msgstr "Más información sobre la protección de la API"

msgid "Learn more about export processing"
msgstr "Más información sobre el procesamiento de exportaciones"

msgid "Leave blank to omit <code>sitemap.xml</code>, <code>feed.xml</code> and the <code>&lt;link rel=\"canonical\"&gt;</code> tag specifying the preferred page URL."
msgstr "Déjalo en blanco para omitir <code>sitemap.xml</code>, <code>feed.xml</code> y la etiqueta <code>&lt;link rel=\"canonical\"&gt;</code> que indica la URL preferida de la página."

msgid "Leave blank to omit a separate copyright or legal notice."
msgstr "Déjalo en blanco para omitir un copyright o aviso legal independiente."

msgid "Leave the title, description and button label blank to use the theme defaults."
msgstr "Deja el título, la descripción y la etiqueta del botón en blanco para utilizar los valores predeterminados del tema."

msgid "Limit public REST API access to the APIs needed for ZeroPress Static comments."
msgstr "Limita el acceso público a la API REST a las API necesarias para los comentarios de ZeroPress Static."

msgid "Manage Cloudflare Turnstile"
msgstr "Gestionar Cloudflare Turnstile"

msgid "Media URL replacements"
msgstr "Sustituciones de URL de medios"

msgid "Media URLs are replaced according to your rules."
msgstr "Las URL de medios se sustituyen según tus reglas."

msgid "Memory (small sites)"
msgstr "Memoria (sitios pequeños)"

msgid "Memory processing supports single XML only. Select Single XML in WXR publishing format, or select Temporary files on Linux for split publishing."
msgstr "El procesamiento en memoria solo admite un único XML. Selecciona XML único en el formato de publicación WXR, o Archivos temporales en Linux para publicar en partes."

msgid "Memory processing uses single XML, including Automatic. To replace an existing split export, select Single XML. Split XML requires Temporary files."
msgstr "El procesamiento en memoria utiliza un único XML, también en Automático. Para reemplazar una exportación dividida, selecciona XML único. El XML dividido requiere Archivos temporales."

msgid "Memory: publishes a single XML without temporary export files. Pausing and continuing publication are unavailable."
msgstr "Memoria: publica un único XML sin archivos temporales de exportación. No permite pausar ni continuar la publicación."

msgid "Menu ID"
msgstr "ID de menú"

msgid "Menus"
msgstr "Menús"

msgid "Newsletter connection"
msgstr "Conexión con el boletín"

msgid "No GitHub token is registered. Reload this page to check its current status."
msgstr "No hay ningún token de GitHub registrado. Recarga esta página para comprobar su estado actual."

msgid "No Turnstile keys are saved. Reload this page to check their current status."
msgstr "No hay claves de Turnstile guardadas. Recarga esta página para comprobar su estado actual."

msgid "No changes to publish."
msgstr "No hay cambios que publicar."

msgid "Not configured"
msgstr "Sin configurar"

msgid "One exported entry is too large to send safely. Reduce unusually large post content or metadata, then prepare again. Increasing PHP memory alone will not remove this limit."
msgstr "Una entrada es demasiado grande para enviarla de forma segura. Reduce el contenido o los metadatos excesivos y vuelve a preparar los datos. Aumentar la memoria PHP no elimina este límite."

msgid "Only published posts and pages without a password are exported. Shortcodes and dynamic blocks are not executed."
msgstr "Solo se exportan las entradas y páginas publicadas sin contraseña. No se ejecutan los shortcodes ni los bloques dinámicos."

msgid "Open <strong>Select repositories</strong> and choose only the repository entered in <strong>Publishing GitHub repository URL</strong> above."
msgstr "Abre <strong>Select repositories</strong> y elige solo el repositorio indicado arriba en <strong>URL del repositorio de GitHub para publicar</strong>."

msgid "Open GitHub publishing"
msgstr "Abrir publicación en GitHub"

msgid "Opens the signup page in a new tab."
msgstr "Abre la página de suscripción en una pestaña nueva."

msgid "Other plugins that use public REST APIs may be affected."
msgstr "Otros plugins que utilicen API REST públicas pueden verse afectados."

msgid "PHP memory limit: {limit}. Estimated memory required: {estimated}."
msgstr "Límite de memoria de PHP: {limit}. Memoria necesaria estimada: {estimated}."

msgid "PHP time limit: {limit} s. Request budget: {budget} s. Elapsed: {elapsed} s."
msgstr "Límite de tiempo de PHP: {limit} s. Tiempo asignado a la solicitud: {budget} s. Transcurrido: {elapsed} s."

msgid "Pause publication"
msgstr "Pausar publicación"

msgid "Pausing…"
msgstr "Pausando…"

msgid "Post ID: {id}. Body size: {bytes} UTF-8 bytes."
msgstr "ID de la entrada: {id}. Tamaño del contenido: {bytes} bytes UTF-8."

msgid "Posts per page"
msgstr "Entradas por página"

msgid "Posts: {posts} · Pages: {pages} · Media: {media} · Menus: {menus}"
msgstr "Entradas: {posts} · Páginas: {pages} · Medios: {media} · Menús: {menus}"

msgid "Prepare and publish"
msgstr "Preparar y publicar"

msgid "Prepare publishing data"
msgstr "Preparar datos para publicar"

msgid "Preparing data…"
msgstr "Preparando datos…"

msgid "Preparing download…"
msgstr "Preparando descarga…"

msgid "Private"
msgstr "Privado"

msgid "Private temporary storage is unavailable. Ask your host to check its permissions and shared storage, then try again."
msgstr "El almacenamiento temporal privado no está disponible. Pide a tu proveedor que revise los permisos y el almacenamiento compartido e inténtalo de nuevo."

msgid "Processing method"
msgstr "Método de procesamiento"

msgid "Processing method saved. Prepare again before downloading or publishing."
msgstr "Método de procesamiento guardado. Vuelve a preparar antes de descargar o publicar."

msgid "Public"
msgstr "Público"

msgid "Public access to this REST API is restricted."
msgstr "El acceso público a esta API REST está restringido."

msgid "Publication cancelled. The branch was not updated."
msgstr "Publicación cancelada. La rama no se ha actualizado."

msgid "Publication is running in one request. Refresh the status if its response was lost."
msgstr "La publicación se está ejecutando en una sola solicitud. Actualiza el estado si se perdió la respuesta."

msgid "Publication needs verification. Use Check publication result; do not publish again until the result is confirmed."
msgstr "Es necesario verificar la publicación. Usa Comprobar resultado; no vuelvas a publicar hasta confirmar el resultado."

msgid "Publication paused. Continue publishing or cancel this publication."
msgstr "Publicación en pausa. Puede continuar o cancelar esta publicación."

msgid "Publication paused. Continue to retry the remaining steps."
msgstr "La publicación está en pausa. Continúa para reintentar los pasos restantes."

msgid "Publication result"
msgstr "Resultado de la publicación"

msgid "Publish"
msgstr "Publicar"

msgid "Publish all saved public posts and pages."
msgstr "Publica todas las entradas y páginas públicas guardadas."

msgid "Publish to GitHub"
msgstr "Publicar en GitHub"

msgid "Publish to GitHub again"
msgstr "Volver a publicar en GitHub"

msgid "Publish your WordPress content to a static site with ZeroPress and GitHub."
msgstr "Publica tu contenido de WordPress en un sitio estático con ZeroPress y GitHub."

msgid "Published to GitHub"
msgstr "Publicado en GitHub"

msgid "Published to GitHub."
msgstr "Publicado en GitHub."

msgid "Publishing GitHub repository URL"
msgstr "URL del repositorio de GitHub para publicar"

msgid "Publishing branch"
msgstr "Rama de publicación"

msgid "Publishing destination"
msgstr "Destino de publicación"

msgid "Publishing help"
msgstr "Ayuda para publicar"

msgid "Publishing target"
msgstr "Destino de publicación"

msgid "Publishing to GitHub…"
msgstr "Publicando en GitHub…"

msgid "Reading settings"
msgstr "Ajustes de lectura"

msgid "Ready to publish to {repository} ({branch})."
msgstr "Todo listo para publicar en {repository} ({branch})."

msgid "Refresh status"
msgstr "Actualizar estado"

msgid "Register a GitHub token to publish."
msgstr "Registra un token de GitHub para publicar."

msgid "Register a GitHub token to test or publish."
msgstr "Registra un token de GitHub para probar la conexión o publicar."

msgid "Register the static site domain in your Turnstile widget."
msgstr "Registra el dominio del sitio estático en tu widget de Turnstile."

msgid "Register token"
msgstr "Registrar token"

msgid "Registering token…"
msgstr "Registrando token…"

msgid "Remove menu assignment"
msgstr "Eliminar asignación de menú"

msgid "Remove replacement"
msgstr "Eliminar sustitución"

msgid "Repository to select:"
msgstr "Repositorio que debes seleccionar:"

msgid "Repository visibility"
msgstr "Visibilidad del repositorio"

msgid "Repository, branch or required export files not found. Check access and the starter input files."
msgstr "No se encuentran el repositorio, la rama o los archivos de exportación necesarios. Revisa el acceso y los archivos de entrada de la plantilla."

msgid "Republish options"
msgstr "Opciones para volver a publicar"

msgid "Restrict public REST API access"
msgstr "Restringir el acceso público a la API REST"

msgid "Review prepared data"
msgstr "Revisar datos preparados"

msgid "Safe publication locking is unavailable. Ask your host to check the WordPress database connection requirements in the publishing guide."
msgstr "No está disponible el bloqueo seguro de publicación. Pide a tu proveedor que revise los requisitos de conexión a la base de datos de WordPress en la guía de publicación."

msgid "Save API protection settings"
msgstr "Guardar ajustes de protección de la API"

msgid "Save Turnstile settings"
msgstr "Guardar ajustes de Turnstile"

msgid "Save a Site Key and Secret Key together to use Turnstile."
msgstr "Guarda una clave del sitio y una clave secreta juntas para utilizar Turnstile."

msgid "Save a static site URL in the Site section to allow comment writing."
msgstr "Guarda la URL del sitio estático en la sección Sitio para permitir escribir comentarios."

msgid "Save comment settings"
msgstr "Guardar ajustes de comentarios"

msgid "Save display and credit settings"
msgstr "Guardar ajustes de visualización y créditos"

msgid "Save media settings"
msgstr "Guardar ajustes de medios"

msgid "Save menu settings"
msgstr "Guardar ajustes de menús"

msgid "Save newsletter settings"
msgstr "Guardar ajustes del boletín"

msgid "Save processing method"
msgstr "Guardar método de procesamiento"

msgid "Save publishing target"
msgstr "Guardar destino de publicación"

msgid "Save search and navigation settings"
msgstr "Guardar ajustes de búsqueda y navegación"

msgid "Save site settings"
msgstr "Guardar ajustes del sitio"

msgid "Save your post changes before preparing or publishing."
msgstr "Guarda los cambios de tu entrada antes de preparar los datos o publicar."

msgid "Saving…"
msgstr "Guardando…"

msgid "Search and archive display depends on your theme."
msgstr "La visualización de la búsqueda y los archivos depende de tu tema."

msgid "Search and content navigation"
msgstr "Búsqueda y navegación de contenido"

msgid "Select classic WordPress menus to publish. Menu IDs connect these selections to your static site theme."
msgstr "Selecciona los menús clásicos de WordPress que quieras publicar. Los ID de menú vinculan estas selecciones con el tema de tu sitio estático."

msgid "Sending this single XML file needs more PHP memory. Select Automatic or Split XML with a compatible starter, or ask your host to increase PHP memory, then prepare again."
msgstr "Enviar este archivo XML único requiere más memoria PHP. Selecciona Automático o XML dividido con una plantilla de inicio compatible, o pide a tu proveedor de alojamiento que aumente la memoria PHP, y vuelve a preparar los datos."

msgid "Set <strong>Contents</strong> to <strong>Read and write</strong>."
msgstr "Establece <strong>Contents</strong> en <strong>Read and write</strong>."

msgid "Set up a WXR starter repository"
msgstr "Preparar un repositorio WXR de inicio"

msgid "Settings"
msgstr "Ajustes"

msgid "Settings changed in another window. Reload before saving."
msgstr "Los ajustes han cambiado en otra ventana. Recarga la página antes de guardar."

msgid "Settings sections"
msgstr "Secciones de ajustes"

msgid "Settings take effect immediately after saving."
msgstr "Los ajustes se aplican inmediatamente después de guardarlos."

msgid "Show WordPress comments on the static site"
msgstr "Mostrar comentarios de WordPress en el sitio estático"

msgid "Show ZeroPress attribution"
msgstr "Mostrar atribución a ZeroPress"

msgid "Show ZeroPress generator information"
msgstr "Mostrar información de ZeroPress como generador"

msgid "Show newsletter signup"
msgstr "Mostrar suscripción al boletín"

msgid "Sign up with a newsletter service such as Hostinger Reach, Omnisend or Mailchimp and prepare a signup page. Enter the page URL below to display a signup prompt on your static site."
msgstr "Regístrate en un servicio de boletines como Hostinger Reach, Omnisend o Mailchimp y prepara una página de suscripción. Introduce su URL a continuación para mostrar una invitación a suscribirse en tu sitio estático."

msgid "Signup page URL"
msgstr "URL de la página de suscripción"

msgid "Single XML"
msgstr "XML único"

msgid "Site"
msgstr "Sitio"

msgid "Site description"
msgstr "Descripción del sitio"

msgid "Site icon"
msgstr "Icono del sitio"

msgid "Site icon preview"
msgstr "Vista previa del icono del sitio"

msgid "Site language"
msgstr "Idioma del sitio"

msgid "Site title"
msgstr "Título del sitio"

msgid "Source URL prefix"
msgstr "Prefijo de URL de origen"

msgid "Source URL prefix example:"
msgstr "Ejemplo de prefijo de URL de origen:"

msgid "Split XML"
msgstr "XML dividido"

msgid "Start with the WXR starter template. Publishing updates its export inputs; compatible starters automatically use split files for large exports. Keep your own settings in wxr-import-base.override.json."
msgstr "Empieza con la plantilla WXR. Al publicar se actualizan sus entradas de exportación; las plantillas compatibles usan archivos divididos automáticamente para exportaciones grandes. Guarda tus ajustes en wxr-import-base.override.json."

msgid "Static site URL"
msgstr "URL del sitio estático"

msgid "Subscribe"
msgstr "Suscribirse"

msgid "Temporary export storage is unavailable. Ask your host to check free disk space and PHP temporary-file permissions, then prepare again."
msgstr "El almacenamiento temporal no está disponible. Pide a tu proveedor de alojamiento que revise el espacio libre y los permisos de los archivos temporales de PHP; después, vuelve a preparar los datos."

msgid "Temporary files (default)"
msgstr "Archivos temporales (predeterminado)"

msgid "Temporary files: uses private storage and supports larger exports, pausing and continuing publication."
msgstr "Archivos temporales: utiliza almacenamiento privado y permite exportaciones más grandes, pausar y continuar la publicación."

msgid "Test connection"
msgstr "Probar conexión"

msgid "Testing connection…"
msgstr "Probando conexión…"

msgid "The GitHub branch changed concurrently. Review it and prepare again."
msgstr "La rama de GitHub se ha modificado al mismo tiempo. Revísala y vuelve a preparar los datos."

msgid "The GitHub token is registered."
msgstr "Se ha registrado el token de GitHub."

msgid "The REST API URL must end in /wp-json/wp/v2."
msgstr "La URL de la API REST debe terminar en /wp-json/wp/v2."

msgid "The confirmation dialog could not be loaded. Reload this page and try again."
msgstr "No se ha podido cargar el diálogo de confirmación. Recarga esta página y vuelve a intentarlo."

msgid "The database connection changed during publication. Check the publication status before trying again."
msgstr "La conexión a la base de datos cambió durante la publicación. Comprueba el estado de la publicación antes de volver a intentarlo."

msgid "The download could not be completed, so no file was saved. Try downloading again. If it keeps failing, ask your host to check connection and request time limits."
msgstr "No se pudo completar la descarga, por lo que no se ha guardado ningún archivo. Intenta descargarlo de nuevo. Si el problema persiste, pide a tu proveedor de alojamiento que revise la conexión y los límites de tiempo de las solicitudes."

msgid "The download is ready. Check your browser downloads."
msgstr "La descarga está lista. Consulta las descargas de tu navegador."

msgid "The export files will be updated together in one commit."
msgstr "Los archivos de exportación se actualizarán juntos en un único commit."

msgid "The memory limit is 8 MiB for XML and settings combined, and 8 MiB for each encoded upload. Server resources can limit smaller exports. No automatic switch to temporary files occurs."
msgstr "El límite en memoria es de 8 MiB para XML y ajustes combinados, y de 8 MiB por cada carga codificada. Los recursos del servidor pueden limitar exportaciones menores. No se cambia automáticamente a archivos temporales."

msgid "The preparation expired or settings changed. Prepare again."
msgstr "Los datos preparados han caducado o los ajustes han cambiado. Vuelve a prepararlos."

msgid "The preparation is invalid. Prepare again."
msgstr "Los datos preparados no son válidos. Vuelve a prepararlos."

msgid "The repository contains incomplete or modified split export files. Review the starter input files and restore a complete published export before preparing again."
msgstr "Los archivos divididos del repositorio están incompletos o modificados. Revisa los archivos de entrada de la plantilla y restaura una exportación publicada completa antes de volver a preparar los datos."

msgid "The repository visibility changed after preparation. Prepare again and review its visibility before publishing."
msgstr "La visibilidad del repositorio ha cambiado desde la preparación. Prepara de nuevo y revisa su visibilidad antes de publicar."

msgid "The request could not be completed. Please retry."
msgstr "No se ha podido completar la solicitud. Inténtalo de nuevo."

msgid "The request reached its time limit. Continue to retry this step. If it keeps stopping, ask your host to review the request time limit."
msgstr "La solicitud alcanzó su límite de tiempo. Continúa para reintentar este paso. Si sigue deteniéndose, pide a tu proveedor que revise el límite de tiempo."

msgid "The saved GitHub token was deleted."
msgstr "Se ha eliminado el token de GitHub guardado."

msgid "The saved keys were deleted and Cloudflare Turnstile is off."
msgstr "Se han eliminado las claves guardadas y Cloudflare Turnstile está desactivado."

msgid "The saved token cannot be decrypted. Delete it and register it again; WordPress secrets may have changed."
msgstr "No se puede descifrar el token guardado. Elimínalo y vuelve a registrarlo; es posible que las claves secretas de WordPress hayan cambiado."

msgid "The server configuration fixes the processing method to Memory."
msgstr "La configuración del servidor fija el método de procesamiento en memoria."

msgid "The server fixes the processing method to Memory. This setting cannot be changed here."
msgstr "El servidor fija el procesamiento en memoria. Este ajuste no se puede cambiar aquí."

msgid "The server time limit stopped this request. Ask your host to review the request time limit, then prepare again."
msgstr "El límite de tiempo del servidor ha detenido esta solicitud. Pide a tu proveedor de alojamiento que revise el límite de tiempo de las solicitudes y vuelve a preparar los datos."

msgid "The token cannot access this repository. Check its selected repositories and permissions."
msgstr "El token no puede acceder a este repositorio. Comprueba los repositorios seleccionados y sus permisos."

msgid "There is not enough PHP memory to complete this request. Increase the server memory allowance and prepare again."
msgstr "No hay suficiente memoria de PHP para completar esta solicitud. Aumenta la memoria permitida en el servidor y vuelve a preparar los datos."

msgid "There is not enough time left on the server to complete this request. Ask your host to review the request time limit, then prepare again."
msgstr "No queda suficiente tiempo en el servidor para completar esta solicitud. Pide a tu proveedor de alojamiento que revise el límite de tiempo de las solicitudes y vuelve a preparar los datos."

msgid "These values are read from WordPress when preparing publishing data."
msgstr "Estos valores se obtienen de WordPress al preparar los datos para publicar."

msgid "This WordPress installation: %s."
msgstr "Esta instalación de WordPress: %s."

msgid "This export exceeds the memory limit of 8 MiB for XML and settings combined or an encoded upload. On Linux, select Temporary files and prepare again."
msgstr "Esta exportación supera el límite en memoria de 8 MiB para XML y ajustes combinados o una carga codificada. En Linux, selecciona Archivos temporales y vuelve a preparar."

msgid "This export exceeds the supported split export limits. Review your export settings or contact support before trying again."
msgstr "Esta exportación supera los límites admitidos para archivos divididos. Revisa la configuración de exportación o contacta con soporte antes de volver a intentarlo."

msgid "This export is too large for a single GitHub file. Select Automatic or Split XML with a compatible starter, then prepare again."
msgstr "Esta exportación es demasiado grande para un único archivo de GitHub. Selecciona Automático o XML dividido con una plantilla de inicio compatible y vuelve a preparar los datos."

msgid "This export needs more available PHP memory. On Linux, select Temporary files and prepare again, or ask your host to review PHP memory."
msgstr "Esta exportación necesita más memoria PHP disponible. En Linux, selecciona Archivos temporales y vuelve a preparar, o pide a tu proveedor que revise la memoria PHP."

msgid "This export will be published as a single XML file."
msgstr "Esta exportación se publicará como un único archivo XML."

msgid "This export will be published in {parts} parts. Your starter will build them as one site. XML downloads remain a single file."
msgstr "Esta exportación se publicará en {parts} partes. Tu plantilla las compilará como un único sitio. La descarga XML sigue siendo un solo archivo."

msgid "This installation does not use the supported <code>/wp-json/wp/v2</code> URL format. Configure a visitor-accessible API using that path; query-style REST URLs are not supported."
msgstr "Esta instalación no utiliza el formato de URL compatible <code>/wp-json/wp/v2</code>. Configura una API accesible para los visitantes con esa ruta; no se admiten las URL REST con parámetros de consulta."

msgid "This publication replaces the single XML file with split export files."
msgstr "Esta publicación sustituye el archivo XML único por archivos de exportación divididos."

msgid "This publication replaces the split export files with one XML file."
msgstr "Esta publicación sustituye los archivos de exportación divididos por un único archivo XML."

msgid "This removes the token stored in this plugin. Register a token again to publish to GitHub."
msgstr "Esto elimina el token almacenado en este plugin. Vuelve a registrar un token para publicar en GitHub."

msgid "This repository is public. Anyone can view uploaded WXR and site settings files and their history. Use a private repository if you do not want to share these source files."
msgstr "Este repositorio es público. Cualquiera puede ver los archivos WXR y de configuración del sitio subidos, así como su historial. Usa un repositorio privado si no quieres compartir estos archivos de origen."

msgid "This section is saved."
msgstr "Se ha guardado esta sección."

msgid "This section is saved. API protection applies immediately."
msgstr "Se ha guardado esta sección. La protección de la API se aplica de inmediato."

msgid "This section is saved. Changes apply to new comment requests."
msgstr "Se ha guardado esta sección. Los cambios se aplican a las nuevas solicitudes de comentarios."

msgid "This section is saved. Changes take effect after the next publication."
msgstr "Se ha guardado esta sección. Los cambios se aplicarán después de la próxima publicación."

msgid "This section is saved. Comment display changes take effect after the next publication; API access and writing settings apply immediately."
msgstr "Se ha guardado esta sección. Los cambios de visualización de comentarios se aplicarán después de la próxima publicación; los ajustes de acceso a la API y de escritura se aplican de inmediato."

msgid "This section is saved. Comment display changes take effect after the next publication; writing settings apply to new comment requests."
msgstr "Se ha guardado esta sección. Los cambios de visualización de comentarios se aplicarán después de la próxima publicación; los ajustes de escritura se aplican a las nuevas solicitudes de comentarios."

msgid "This single-request publication stopped. Cancel it and prepare again. Its uploads cannot be resumed."
msgstr "Esta publicación de una sola solicitud se detuvo. Cancélala y vuelve a preparar los datos. Las subidas no se pueden reanudar."

msgid "This starter does not support split XML. Update the complete WXR starter, or select Automatic or Single XML, then prepare again."
msgstr "Esta plantilla de inicio no admite XML dividido. Actualiza la plantilla WXR completa o selecciona Automático o XML único y vuelve a preparar los datos."

msgid "This version supports single-site WordPress only."
msgstr "Esta versión solo es compatible con instalaciones de WordPress de un solo sitio."

msgid "Time remaining: {remaining} s. Minimum wait between requests: {minimum} s, plus transfer time."
msgstr "Tiempo restante: {remaining} s. Espera mínima entre solicitudes: {minimum} s, más el tiempo de transferencia."

msgid "Timezone"
msgstr "Zona horaria"

msgid "Title"
msgstr "Título"

msgid "To allow comment writing, save a static site URL in the Site section. Request origins are checked against this address."
msgstr "Para permitir escribir comentarios, guarda la URL del sitio estático en la sección Sitio. Los orígenes de las solicitudes se comprueban con esta dirección."

msgid "Too many comment requests. Please try again shortly."
msgstr "Demasiadas solicitudes de comentarios. Vuelve a intentarlo en unos instantes."

msgid "Turnstile Secret Key"
msgstr "Clave secreta de Turnstile"

msgid "Turnstile Site Key"
msgstr "Clave del sitio de Turnstile"

msgid "Unavailable menu (ID {id})"
msgstr "Menú no disponible (ID {id})"

msgid "Unconfirmed"
msgstr "Sin confirmar"

msgid "Under <strong>Repository access</strong>, choose <strong>Only select repositories</strong>."
msgstr "En <strong>Repository access</strong>, elige <strong>Only select repositories</strong>."

msgid "Unfinished publication"
msgstr "Publicación sin finalizar"

msgid "Unknown author"
msgstr "Autor desconocido"

msgid "Unsaved changes"
msgstr "Cambios sin guardar"

msgid "Update the WXR generation time and create a new commit without changing the content."
msgstr "Actualiza la fecha de generación del WXR y crea un nuevo commit sin cambiar el contenido."

msgid "Uploading files to GitHub…"
msgstr "Subiendo archivos a GitHub…"

msgid "Use Cloudflare Turnstile"
msgstr "Utilizar Cloudflare Turnstile"

msgid "Use an API URL that site visitors can access."
msgstr "Utiliza una URL de API a la que puedan acceder los visitantes del sitio."

msgid "Use primary for the main navigation and footer for footer links. Custom IDs must match the menu IDs used by your theme."
msgstr "Utiliza primary para la navegación principal y footer para los enlaces del pie de página. Los ID personalizados deben coincidir con los ID de menú de tu tema."

msgid "Use unique menu IDs starting with a lowercase letter, followed by lowercase letters, numbers, hyphens or underscores (up to 64 characters)."
msgstr "Utiliza ID de menú únicos que empiecen por una letra minúscula, seguida de letras minúsculas, números, guiones o guiones bajos (hasta 64 caracteres)."

msgid "Use up to 50 complete source and destination URL pairs."
msgstr "Utiliza un máximo de 50 pares completos de URL de origen y destino."

msgid "Verifying publishing data…"
msgstr "Verificando datos para publicar…"

msgid "Verifying the GitHub publication result…"
msgstr "Verificando el resultado de la publicación en GitHub…"

msgid "View commit"
msgstr "Ver commit"

msgid "View on static site"
msgstr "Ver en el sitio estático"

msgid "View saved publishing repository"
msgstr "Ver repositorio de publicación guardado"

msgid "WXR publishing format"
msgstr "Formato de publicación WXR"

msgid "Wait for WordPress to finish saving your post."
msgstr "Espera a que WordPress termine de guardar tu entrada."

msgid "Waiting for the current request to finish before pausing."
msgstr "La publicación se pausará cuando termine la solicitud actual."

msgid "When unchecked, <code>Disallow: /</code> is written to the static site's <code>robots.txt</code>."
msgstr "Si no está marcado, se escribe <code>Disallow: /</code> en el archivo <code>robots.txt</code> del sitio estático."

msgid "When writing is off, only comments are shown. Your existing WordPress comment settings still apply."
msgstr "Si la escritura está desactivada, solo se muestran los comentarios. Se siguen aplicando tus ajustes de comentarios de WordPress."

msgid "Windows supports Memory processing only."
msgstr "Windows solo admite el procesamiento en memoria."

msgid "WordPress REST API URL"
msgstr "URL de la API REST de WordPress"

msgid "WordPress content changed. Prepare again to include the latest data."
msgstr "El contenido de WordPress ha cambiado. Vuelve a preparar los datos para incluir los más recientes."

msgid "WordPress data could not be read safely. Review unusual metadata and plugins that customize content or media, then prepare again."
msgstr "No se pudieron leer los datos de WordPress de forma segura. Revisa los metadatos inusuales y los plugins que modifican el contenido o los medios y vuelve a preparar los datos."

msgid "WordPress menu"
msgstr "Menú de WordPress"

msgid "Working…"
msgstr "Procesando…"

msgid "ZeroPress"
msgstr "ZeroPress"

msgid "ZeroPress Static"
msgstr "ZeroPress Static"

msgid "ZeroPress Static – Static Site Publisher"
msgstr "ZeroPress Static – Publicador de sitios estáticos"

msgid "ZeroPress publish"
msgstr "Publicación con ZeroPress"

msgid "{count} posts or pages have bodies of 256 KiB or more (largest: {bytes} UTF-8 bytes). Consider splitting them into smaller posts. Example IDs: {ids}."
msgstr "{count} entradas o páginas tienen un contenido de 256 KiB o más (máximo: {bytes} bytes UTF-8). Considera dividirlas en entradas más pequeñas. Ejemplos de ID: {ids}."
