msgstr "{count} entradas o páginas tienen un contenido de 256 KiB o más (máximo: {bytes} bytes UTF-8). Considera dividirlas en entradas más pequeñas. Ejemplos de ID: {ids}."

msgid "{media}"
msgstr "{media}"

