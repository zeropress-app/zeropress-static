msgstr "Cloudflare Turnstile puede ayudar a reducir los ataques de envío automatizado de comentarios."

msgid "Comment display and writing"
msgstr "Visualización y escritura de comentarios"

msgid "Comment request limiting is temporarily unavailable. Please try again later."
msgstr "La limitación de solicitudes de comentarios no está disponible temporalmente. Vuelve a intentarlo más tarde."

msgid "Comment writing could not be verified. Refresh the writing options and try again."
msgstr "No se ha podido verificar el envío del comentario. Actualiza las opciones de escritura y vuelve a intentarlo."

msgid "Comments"
msgstr "Comentarios"

msgid "Connection details changed. Test again to check these values."
msgstr "Los datos de conexión han cambiado. Vuelve a probar la conexión para comprobar estos valores."

msgid "Content"
msgstr "Contenido"

msgid "Continue publication"
msgstr "Continuar publicación"

msgid "Create a GitHub token"
msgstr "Crear un token de GitHub"

msgid "Delete record"
msgstr "Eliminar registro"

msgid "Delete saved keys"
msgstr "Eliminar claves guardadas"

