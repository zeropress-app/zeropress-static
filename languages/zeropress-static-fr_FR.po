msgstr "Laissez ce champ vide pour omettre <code>sitemap.xml</code>, <code>feed.xml</code> et la balise <code>&lt;link rel=\"canonical\"&gt;</code> indiquant l’URL préférée de la page."

msgid "Leave blank to omit a separate copyright or legal notice."
msgstr "Laissez ce champ vide pour ne pas afficher de mention distincte de droits d’auteur ou de mentions légales."

