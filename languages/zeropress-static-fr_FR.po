msgstr "Affiche la page d’inscription dans une fenêtre contextuelle sur votre site. Utilisez l’URL d’une page autorisant l’intégration dans une iframe."

msgid "Do not publish"
msgstr "Ne pas publier"

msgid "Download WXR"
msgstr "Télécharger le WXR"

msgid "Download build settings"
msgstr "Télécharger les réglages de compilation"

