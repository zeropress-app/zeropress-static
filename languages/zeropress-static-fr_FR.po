msgid "Enable JavaScript to save settings and prepare publishing data."
msgstr "Activez JavaScript pour enregistrer les réglages et préparer les données à publier."

msgid "Enable search"
msgstr "Activer la recherche"

msgid "Enter Turnstile keys without spaces or line breaks."
msgstr "Saisissez les clés Turnstile sans espaces ni sauts de ligne."

msgid "Enter a GitHub repository before testing the connection."
msgstr "Saisissez un dépôt GitHub avant de tester la connexion."

msgid "Enter a REST API URL that site visitors can access to enable comments."
msgstr "Saisissez une URL d’API REST accessible aux visiteurs du site pour activer les commentaires."

msgid "Enter a Secret Key without spaces or line breaks."
msgstr "Saisissez une clé secrète sans espaces ni sauts de ligne."

msgid "Enter a Turnstile Site Key."
msgstr "Saisissez une clé de site Turnstile."

msgid "Enter a button label of up to 200 characters."
msgstr "Saisissez un libellé de bouton de 200 caractères maximum."

msgid "Enter a description of up to 2,000 characters."
msgstr "Saisissez une description de 2 000 caractères maximum."

msgid "Enter a github.com repository URL or owner/repository."
msgstr "Saisissez l’URL d’un dépôt github.com ou propriétaire/dépôt."

msgid "Enter a signup page URL or an embedded signup page URL."
msgstr "Saisissez l’URL d’une page d’inscription ou d’une page d’inscription intégrée."

msgid "Enter a static site URL to allow comment writing."
msgstr "Saisissez l’URL du site statique pour autoriser l’envoi de commentaires."

msgid "Enter a title of up to 200 characters."
msgstr "Saisissez un titre de 200 caractères maximum."

msgid "Enter a token without spaces or line breaks."
msgstr "Saisissez un jeton sans espaces ni sauts de ligne."

msgid "Enter a valid HTTP(S) embedded signup page URL or site-relative path (up to 2,048 characters)."
msgstr "Saisissez une URL HTTP(S) valide de page d’inscription intégrée ou un chemin relatif au site (2 048 caractères maximum)."

msgid "Enter a valid HTTP(S) signup page URL or site-relative path (up to 2,048 characters)."
msgstr "Saisissez une URL HTTP(S) valide de page d’inscription ou un chemin relatif au site (2 048 caractères maximum)."

msgid "Enter an HTTP(S) URL without credentials, a query or a fragment."
msgstr "Saisissez une URL HTTP(S) sans identifiants, paramètres de requête ni fragment."

msgid "Enter an HTTP(S) page URL or a path starting with <code>/</code>. At least one of the two URLs is required."
msgstr "Saisissez une URL de page HTTP(S) ou un chemin commençant par <code>/</code>. Au moins une des deux URL est requise."

msgid "Enter the Secret Key for this Site Key."
msgstr "Saisissez la clé secrète correspondant à cette clé de site."

msgid "Enter the publishing branch name. Tags and commit URLs are not supported."
msgstr "Saisissez le nom de la branche de publication. Les étiquettes et les URL de commits ne sont pas prises en charge."

msgid "Enter the site origin without a path."
msgstr "Saisissez l’origine du site sans chemin."

msgid "Example based on this WordPress installation: %s."
msgstr "Exemple basé sur cette installation WordPress : %s."

msgid "Examples: %1$s · %2$s · %3$s"
msgstr "Exemples : %1$s · %2$s · %3$s"

