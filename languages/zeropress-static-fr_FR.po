msgstr "Clé de site Turnstile"

msgid "Unavailable menu (ID {id})"
msgstr "Menu indisponible (ID {id})"

msgid "Under <strong>Repository access</strong>, choose <strong>Only select repositories</strong>."
msgstr "Dans <strong>Repository access</strong>, choisissez <strong>Only select repositories</strong>."

msgid "Unknown author"
msgstr "Auteur inconnu"

msgid "Unsaved changes"
msgstr "Modifications non enregistrées"

msgid "Update the WXR generation time and create a new commit without changing the content."
msgstr "Actualisez la date de génération du WXR et créez un nouveau commit sans modifier le contenu."

msgid "Uploading files to GitHub…"
msgstr "Envoi des fichiers vers GitHub…"

msgid "Use Cloudflare Turnstile"
msgstr "Utiliser Cloudflare Turnstile"

msgid "Use an API URL that site visitors can access."
msgstr "Utilisez une URL d’API accessible aux visiteurs du site."

msgid "Use primary for the main navigation and footer for footer links. Custom IDs must match the menu IDs used by your theme."
msgstr "Utilisez primary pour la navigation principale et footer pour les liens de pied de page. Les identifiants personnalisés doivent correspondre aux identifiants de menu de votre thème."

msgid "Use unique menu IDs starting with a lowercase letter, followed by lowercase letters, numbers, hyphens or underscores (up to 64 characters)."
msgstr "Utilisez des identifiants de menu uniques commençant par une lettre minuscule, suivie de lettres minuscules, de chiffres, de traits d’union ou de tirets bas (64 caractères maximum)."

msgid "Use up to 50 complete source and destination URL pairs."
msgstr "Utilisez jusqu’à 50 paires complètes d’URL source et de destination."

msgid "Verifying publishing data…"
msgstr "Vérification des données à publier…"

msgid "Verifying the GitHub publication result…"
msgstr "Vérification du résultat de la publication sur GitHub…"

msgid "View commit"
msgstr "Voir le commit"

msgid "View on static site"
msgstr "Voir sur le site statique"

msgid "View saved publishing repository"
msgstr "Voir le dépôt de publication enregistré"

msgid "Wait for WordPress to finish saving your post."
msgstr "Attendez que WordPress ait terminé d’enregistrer votre article."

msgid "When unchecked, <code>Disallow: /</code> is written to the static site's <code>robots.txt</code>."
msgstr "Lorsque cette option est décochée, <code>Disallow: /</code> est ajouté au fichier <code>robots.txt</code> du site statique."

msgid "When writing is off, only comments are shown. Your existing WordPress comment settings still apply."
msgstr "Lorsque l’envoi est désactivé, les commentaires sont uniquement affichés. Vos réglages de commentaires WordPress restent applicables."

msgid "WordPress REST API URL"
msgstr "URL de l’API REST WordPress"

msgid "WordPress content changed. Prepare again to include the latest data."
msgstr "Le contenu WordPress a changé. Préparez à nouveau les données pour inclure les dernières modifications."

msgid "WordPress menu"
msgstr "Menu WordPress"

msgid "Working…"
msgstr "Traitement en cours…"

msgid "ZeroPress"
msgstr "ZeroPress"

msgid "ZeroPress Static"
msgstr "ZeroPress Static"

msgid "ZeroPress Static – Static Site Publisher"
msgstr "ZeroPress Static – Publication de sites statiques"

msgid "ZeroPress publish"
msgstr "Publication ZeroPress"
