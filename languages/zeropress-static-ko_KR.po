msgid ""
msgstr "Project-Id-Version: ZeroPress Static 1.0.0\nContent-Type: text/plain; charset=UTF-8\nLanguage: ko_KR\nPlural-Forms: nplurals=1; plural=0;\n"

msgid "(No label)"
msgstr "(문구 없음)"

msgid "A GitHub branch rule rejected direct publication. Review the repository rules."
msgstr "GitHub 브랜치 규칙이 직접 발행을 거부했습니다. 저장소 규칙을 확인하세요."

msgid "A GitHub token is already registered. Reload this page to manage it."
msgstr "GitHub 토큰이 이미 등록되어 있습니다. 페이지를 새로고침하여 관리하세요."

msgid "A GitHub token is registered."
msgstr "GitHub 토큰이 등록되어 있습니다."

msgid "A Turnstile Secret Key is registered."
msgstr "Turnstile Secret Key가 등록되어 있습니다."

msgid "A post or page exceeds the 4 MiB body limit. Split or shorten its body, then prepare again."
msgstr "글 또는 페이지 본문이 4 MiB 한도를 초과했습니다. 본문을 나누거나 줄인 후 다시 준비하세요."

msgid "A processing-method change is in progress or was interrupted. Reload settings and save the processing method again before preparing."
msgstr "처리 방식 변경이 진행 중이거나 중단되었습니다. 설정을 새로고침하고 처리 방식을 다시 저장한 뒤 준비하세요."

msgid "A publication is in progress. Continue it here if the previous page was closed."
msgstr "진행 중인 발행이 있습니다. 이전 페이지를 닫았다면 여기에서 계속할 수 있습니다."

msgid "A selected WordPress menu is unavailable. Reload settings and select a menu again."
msgstr "선택한 WordPress 메뉴를 사용할 수 없습니다. 설정을 새로고침하고 메뉴를 다시 선택하세요."

msgid "A source media prefix has conflicting destinations."
msgstr "동일한 미디어 원본 prefix에 서로 다른 대상이 설정되었습니다."

msgid "A static site URL is required to generate the feed."
msgstr "정적 사이트 URL을 설정해야 생성됩니다."

msgid "A target file changed on GitHub. Review the change and prepare again."
msgstr "GitHub의 대상 파일이 변경되었습니다. 변경 내용을 확인한 뒤 다시 준비하세요."

msgid "API protection"
msgstr "API 보호"

msgid "Add custom menu"
msgstr "사용자 지정 메뉴 추가"

msgid "Add replacement"
msgstr "치환 규칙 추가"

msgid "Adds <code>&lt;meta name=\"generator\"&gt;</code> to the HTML."
msgstr "HTML에 <code>&lt;meta name=\"generator\"&gt;</code>를 추가합니다."

msgid "Allow comment writing on the static site"
msgstr "정적 사이트에서 댓글 작성 허용"

msgid "Allow search engines to visit this site"
msgstr "검색엔진의 사이트 수집 허용"

msgid "An unfinished publication uses the previous processing method. Resolve it before changing methods. An uncertain result can still be checked."
msgstr "완료되지 않은 발행이 이전 처리 방식을 사용하고 있습니다. 해당 발행을 처리한 뒤 방식을 변경하세요. 불확실한 결과는 계속 확인할 수 있습니다."

msgid "Another publication is in progress."
msgstr "다른 발행이 진행 중입니다."

msgid "Apple touch icon"
msgstr "Apple 터치 아이콘"

msgid "Applying changes on GitHub…"
msgstr "GitHub에 변경사항을 반영하고 있습니다…"

msgid "Approval expired. Cancel this publication and prepare the data again."
msgstr "발행 승인 시간이 만료되었습니다. 이 발행을 취소하고 데이터를 다시 준비해 주세요."

msgid "Authenticated encryption is unavailable. Enable OpenSSL AES-256-GCM on the server before registering credentials."
msgstr "인증 암호화를 사용할 수 없습니다. 인증 정보를 등록하려면 서버에서 OpenSSL AES-256-GCM을 활성화하세요."

msgid "Automatic"
msgstr "자동"

msgid "Build settings"
msgstr "빌드 설정"

msgid "Button label"
msgstr "버튼 문구"

msgid "Cancel"
msgstr "취소"

msgid "Cancel publication"
msgstr "발행 취소"

msgid "Cancellation requested. Waiting for the current request to finish."
msgstr "취소를 요청했습니다. 현재 요청이 끝나기를 기다리고 있습니다."

msgid "Cancelling publication…"
msgstr "발행 취소 중…"

msgid "Change keys"
msgstr "키 변경"

msgid "Check publication result"
msgstr "발행 결과 확인"

msgid "Check the values in this section."
msgstr "이 섹션의 입력값을 확인하세요."

msgid "Checking publication status…"
msgstr "발행 상태 확인 중…"

msgid "Checking the GitHub repository…"
msgstr "GitHub 저장소를 확인하고 있습니다…"

msgid "Choose how to process publishing data."
msgstr "발행 데이터를 처리하는 방식을 선택합니다."

msgid "Click “Save publishing target” to save these changes."
msgstr "변경한 내용을 저장하려면 ‘발행 대상 저장’을 클릭하세요."

msgid "Client-supplied REST route overrides are disabled."
msgstr "클라이언트의 REST 경로 재지정이 차단되어 있습니다."

msgid "Close"
msgstr "닫기"

msgid "Close confirmation"
msgstr "확인창 닫기"

msgid "Cloudflare Privacy Policy"
msgstr "Cloudflare 개인정보 보호 정책"

msgid "Cloudflare Turnstile"
msgstr "Cloudflare Turnstile"

msgid "Cloudflare Turnstile (optional)"
msgstr "Cloudflare Turnstile (선택)"

msgid "Cloudflare Turnstile can help reduce automated comment submission attacks."
msgstr "Cloudflare Turnstile을 사용하면 자동화된 댓글 작성 공격을 줄일 수 있습니다."

msgid "Comment display and writing"
msgstr "댓글 표시·작성"

msgid "Comment request limiting is temporarily unavailable. Please try again later."
msgstr "댓글 요청 제한을 확인할 수 없습니다. 잠시 후 다시 시도해 주세요."

msgid "Comment writing could not be verified. Refresh the writing options and try again."
msgstr "댓글 작성을 확인할 수 없습니다. 작성 설정을 다시 확인한 뒤 시도하세요."

msgid "Comments"
msgstr "댓글"

msgid "Connection details changed. Test again to check these values."
msgstr "연결 정보가 변경되었습니다. 변경한 값으로 연결을 다시 확인하세요."

msgid "Content"
msgstr "콘텐츠"

msgid "Continue publication"
msgstr "계속 발행"

msgid "Create a GitHub token"
msgstr "GitHub 토큰 생성"

msgid "Delete saved keys"
msgstr "저장된 키 삭제"

msgid "Delete saved token"
msgstr "저장된 토큰 삭제"

msgid "Delete the saved GitHub token?"
msgstr "저장된 GitHub 토큰을 삭제할까요?"

msgid "Delete the saved Site Key and Secret Key and turn off Cloudflare Turnstile."
msgstr "저장된 Site Key와 Secret Key를 삭제하고 Cloudflare Turnstile 사용을 끕니다."

msgid "Delete the saved Turnstile keys?"
msgstr "저장된 Turnstile 키를 삭제할까요?"

msgid "Delete token"
msgstr "토큰 삭제"

msgid "Deleting keys…"
msgstr "키 삭제 중…"

msgid "Deleting token…"
msgstr "토큰 삭제 중…"

msgid "Description"
msgstr "설명"

msgid "Destination URL prefix"
msgstr "대상 URL prefix"

msgid "Destination URL prefix example:"
msgstr "대상 URL prefix 예시:"

msgid "Destination will be determined during the site build."
msgstr "목적지 주소는 사이트 빌드 시 결정됩니다."

msgid "Destinations use your saved site settings. Preparation excludes unavailable or non-public items."
msgstr "저장된 사이트 설정을 기준으로 목적지 주소를 표시합니다. 준비할 때 사용할 수 없거나 비공개인 항목을 제외합니다."

msgid "Display and credits"
msgstr "표시 및 출처"

msgid "Displays <code>Published with ZeroPress</code> in the theme footer."
msgstr "테마 하단에 <code>Published with ZeroPress</code>를 표시합니다."

msgid "Displays the signup page in a popup on your site. Use a page URL that allows iframe embedding."
msgstr "구독 페이지를 사이트 안의 팝업에 표시합니다. iframe 표시를 허용하는 페이지 URL을 입력하세요."

msgid "Download WXR"
msgstr "WXR 다운로드"

msgid "Download build settings"
msgstr "빌드 설정 다운로드"

msgid "Download sizes; media files are not included."
msgstr "다운로드 파일의 크기이며, 미디어 파일은 포함하지 않습니다."

msgid "Downloads"
msgstr "다운로드"

msgid "Downloads ready. Connect GitHub and prepare again to check publishing."
msgstr "다운로드할 준비가 되었습니다. GitHub를 연결하고 다시 준비하여 발행 가능 여부를 확인하세요."

msgid "Downloads ready; publishing blocked."
msgstr "다운로드는 가능하지만 발행이 차단되었습니다."

msgid "Edit in WordPress"
msgstr "WordPress에서 편집"

msgid "Edit in WordPress settings"
msgstr "WordPress 설정에서 수정"

msgid "Edit publishing settings"
msgstr "발행 설정 수정"

msgid "Embedded signup page URL"
msgstr "사이트 내 구독 화면 URL"

msgid "Enable JavaScript to save settings and prepare publishing data."
msgstr "설정 저장과 발행 데이터 준비를 위해 JavaScript를 활성화하세요."

msgid "Enable search on the static site"
msgstr "정적 사이트 내 검색 활성화"

msgid "Enter Turnstile keys without spaces or line breaks."
msgstr "공백이나 줄바꿈 없이 Turnstile 키를 입력하세요."

msgid "Enter a GitHub repository before testing the connection."
msgstr "연결을 확인하기 전에 GitHub 저장소를 입력하세요."

msgid "Enter a REST API URL that site visitors can access to enable comments."
msgstr "댓글을 사용하려면 사이트 방문자가 접근할 수 있는 REST API URL을 입력하세요."

msgid "Enter a Secret Key without spaces or line breaks."
msgstr "공백이나 줄바꿈 없이 Secret Key를 입력하세요."

msgid "Enter a Turnstile Site Key."
msgstr "Turnstile Site Key를 입력하세요."

msgid "Enter a button label of up to 200 characters."
msgstr "버튼 문구는 200자 이내로 입력하세요."

msgid "Enter a description of up to 2,000 characters."
msgstr "설명은 2,000자 이내로 입력하세요."

msgid "Enter a github.com repository URL or owner/repository."
msgstr "github.com 저장소 URL 또는 owner/repository를 입력하세요."

msgid "Enter a signup page URL or an embedded signup page URL."
msgstr "구독 페이지 URL 또는 사이트 내 구독 화면 URL을 입력하세요."

msgid "Enter a title of up to 200 characters."
msgstr "제목은 200자 이내로 입력하세요."

msgid "Enter a token without spaces or line breaks."
msgstr "공백이나 줄바꿈 없이 토큰을 입력하세요."

msgid "Enter a valid HTTP(S) embedded signup page URL or site-relative path (up to 2,048 characters)."
msgstr "올바른 HTTP(S) 사이트 내 구독 화면 URL 또는 사이트 기준 경로를 입력하세요(최대 2,048자)."

msgid "Enter a valid HTTP(S) signup page URL or site-relative path (up to 2,048 characters)."
msgstr "올바른 HTTP(S) 구독 페이지 URL 또는 사이트 기준 경로를 입력하세요(최대 2,048자)."

msgid "Enter a whole number of at least 1 for posts per page."
msgstr "페이지당 글 수에 1 이상의 정수를 입력하세요."

msgid "Enter an HTTP(S) URL without credentials, a query or a fragment."
msgstr "인증 정보, 쿼리, fragment가 없는 HTTP(S) URL을 입력하세요."

msgid "Enter an HTTP(S) page URL or a path starting with <code>/</code>. At least one of the two URLs is required."
msgstr "HTTP(S) 페이지 URL 또는 <code>/</code>로 시작하는 경로를 입력하세요. 두 URL 중 하나 이상이 필요합니다."

msgid "Enter the Secret Key for this Site Key."
msgstr "이 Site Key에 해당하는 Secret Key를 입력하세요."

msgid "Enter the publishing branch name. Tags and commit URLs are not supported."
msgstr "발행할 브랜치 이름을 입력하세요. 태그와 커밋 URL은 지원하지 않습니다."

msgid "Enter the site origin without a path."
msgstr "경로를 제외한 사이트 기준 주소를 입력하세요."

msgid "Example based on this WordPress installation: %s."
msgstr "현재 WordPress 주소 기준 예: %s."

msgid "Examples: %1$s · %2$s"
msgstr "예: %1$s · %2$s"

msgid "External services handle data under their own privacy policies."
msgstr "외부 서비스는 각 서비스의 개인정보 보호 정책에 따라 데이터를 처리합니다."

msgid "Featured image"
msgstr "대표 이미지"

msgid "Files (recommended)"
msgstr "파일 기반 (권장)"

msgid "Files to update"
msgstr "갱신할 파일"

msgid "Files: uses private temporary files to process large amounts of publishing data and supports pausing and continuing publication."
msgstr "파일 기반: 비공개 임시 파일을 사용하며, 대용량 발행 데이터 처리와 발행 일시정지·계속 발행을 지원합니다."

msgid "Finish or cancel the current publication before changing methods. If its result is uncertain, check the result first."
msgstr "처리 방식을 변경하려면 현재 발행을 완료하거나 취소하세요. 결과가 불확실하면 먼저 발행 결과를 확인하세요."

msgid "Footer text and ZeroPress attribution depend on theme support."
msgstr "하단 문구와 ZeroPress 출처 표시는 테마 지원에 따라 달라집니다."

msgid "Generate RSS feed"
msgstr "RSS 피드 생성"

msgid "Generate chronological archives"
msgstr "시간순 아카이브 생성"

msgid "Get new posts and updates by email."
msgstr "새 글과 소식을 이메일로 전해드립니다."

msgid "Get the latest news by email"
msgstr "새 소식을 이메일로 받아보세요"

msgid "GitHub"
msgstr "GitHub"

msgid "GitHub Privacy Statement"
msgstr "GitHub 개인정보 보호 정책"

msgid "GitHub already contains this data. You do not need to publish again."
msgstr "GitHub에 동일한 데이터가 반영되어 있어 다시 발행할 필요가 없습니다."

msgid "GitHub connection confirmed."
msgstr "GitHub 연결을 확인했습니다."

msgid "GitHub connection required"
msgstr "GitHub 연결 필요"

msgid "GitHub did not accept the registered token. Delete it and register a token again, then test the connection."
msgstr "GitHub에서 등록된 토큰을 인증하지 못했습니다. 토큰을 삭제하고 다시 등록한 후 연결을 테스트하세요."

msgid "GitHub did not return a recognized repository visibility. Check the connection and prepare again."
msgstr "GitHub에서 확인 가능한 저장소 공개 범위를 반환하지 않았습니다. 연결을 확인하고 다시 준비하세요."

msgid "GitHub is temporarily unavailable or the request timed out."
msgstr "GitHub를 일시적으로 사용할 수 없거나 요청 시간이 초과되었습니다."

msgid "GitHub publishing"
msgstr "GitHub 발행"

msgid "GitHub publishing (optional)"
msgstr "GitHub 발행 (선택)"

msgid "GitHub rejected an oversized file or request. Review unusually large content or metadata before preparing again."
msgstr "GitHub가 너무 큰 파일이나 요청을 거부했습니다. 지나치게 큰 본문이나 메타데이터를 확인한 뒤 다시 준비하세요."

msgid "GitHub rejected the write. Check repository permissions and branch rules."
msgstr "GitHub가 쓰기를 거부했습니다. 저장소 권한과 브랜치 규칙을 확인하세요."

msgid "GitHub repository"
msgstr "GitHub 저장소"

msgid "GitHub request limit reached. Wait before trying again."
msgstr "GitHub 요청 제한에 도달했습니다. 잠시 후 다시 시도하세요."

msgid "GitHub token"
msgstr "GitHub 토큰"

msgid "GitHub token management"
msgstr "GitHub 토큰 관리"

msgid "GitHub tokens and Turnstile secret keys are stored encrypted in WordPress."
msgstr "GitHub 토큰과 Turnstile 비밀 키는 WordPress에 암호화하여 저장합니다."

msgid "Icon URLs for publishing"
msgstr "발행에 사용할 아이콘 URL"

msgid "If you connect GitHub, the plugin contacts it when you test the connection, prepare data or publish. Publishing sends public content and site settings to your selected repository."
msgstr "GitHub를 연결하면 연결 확인, 데이터 준비, 발행 시 GitHub와 통신합니다. 발행할 때 공개 콘텐츠와 사이트 설정을 선택한 저장소로 전송합니다."

msgid "If you connect a newsletter signup page, visitors contact that service when they open or view it on your site. The service handles their subscription information."
msgstr "뉴스레터 구독 페이지를 연결하면 방문자가 해당 페이지를 열거나 사이트 안에서 볼 때 해당 서비스와 통신합니다. 구독 정보는 해당 서비스에서 처리합니다."

msgid "Information from WordPress"
msgstr "WordPress에서 가져온 정보"

msgid "Internal"
msgstr "내부 공개"

msgid "Items: {count}"
msgstr "항목 {count}개"

msgid "JSON file"
msgstr "JSON 파일"

msgid "Learn more (English)"
msgstr "자세히 알아보기 (영문)"

msgid "Learn more about API protection"
msgstr "API 보호 자세히 알아보기"

msgid "Learn more about publishing data processing"
msgstr "발행 데이터 처리 방식 자세히 알아보기"

msgid "Leave blank to hide this text."
msgstr "비워 두면 이 문구를 표시하지 않습니다."

msgid "Leave blank to skip generating the sitemap and RSS feed."
msgstr "비워 두면 사이트맵과 RSS 피드를 생성하지 않습니다."

msgid "Leave the title, description and button label blank to use the theme defaults."
msgstr "제목·설명·버튼 문구를 비워두면 테마의 기본 문구를 사용합니다."

msgid "Loading details…"
msgstr "상세 정보 불러오는 중…"

msgid "Manage Cloudflare Turnstile"
msgstr "Cloudflare Turnstile 관리"

msgid "Media URL reference"
msgstr "미디어 주소 확인용"

msgid "Media URL replacements"
msgstr "미디어 URL 치환"

msgid "Media URLs are replaced according to your rules."
msgstr "미디어 URL을 설정한 규칙에 따라 치환합니다."

msgid "Media information"
msgstr "미디어 정보"

msgid "Memory"
msgstr "메모리 기반"

msgid "Memory processing limit"
msgstr "메모리 방식 한도 사용률"

msgid "Memory processing publishes single XML even when Automatic is selected."
msgstr "메모리 기반에서는 자동을 선택해도 단일 XML로 발행합니다."

msgid "Memory processing supports single XML only. Select Single XML in WXR publishing format, or select Files on Linux for split publishing."
msgstr "메모리 기반은 단일 XML만 지원합니다. WXR 발행 형식에서 단일 XML을 선택하세요. Linux에서 분할 발행하려면 파일 기반을 선택하세요."

msgid "Memory, time and publishing conditions are checked again when you publish."
msgstr "발행할 때 메모리·시간과 발행 조건을 다시 검사합니다."

msgid "Memory: publishes a single XML without temporary files. Publishing data is limited to 8 MiB; upload size and server resources may impose a lower limit."
msgstr "메모리 기반: 임시 파일 없이 단일 XML로 발행합니다. 발행 데이터는 최대 8 MiB이며, 전송 크기와 서버 자원에 따라 더 작은 발행 데이터도 제한될 수 있습니다."

msgid "Menu ID"
msgstr "메뉴 ID"

