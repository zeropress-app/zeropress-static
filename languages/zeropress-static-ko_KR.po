msgstr "설정 저장과 발행 데이터 준비를 위해 JavaScript를 활성화하세요."

msgid "Enable search"
msgstr "검색 기능 활성화"

msgid "Enter CSS of up to 65,536 characters."
msgstr "CSS를 최대 65,536자까지 입력하세요."

msgid "Enter HTML of up to 65,536 characters."
msgstr "HTML을 최대 65,536자까지 입력하세요."

msgid "Enter Turnstile keys without spaces or line breaks."
msgstr "공백이나 줄바꿈 없이 Turnstile 키를 입력하세요."

msgid "Enter a GitHub repository before testing the connection."
msgstr "연결을 확인하기 전에 GitHub 저장소를 입력하세요."

msgid "Enter a REST API URL that site visitors can access to enable comments."
msgstr "댓글을 사용하려면 사이트 방문자가 접근할 수 있는 REST API URL을 입력하세요."

msgid "Enter a Secret Key without spaces or line breaks."
msgstr "공백이나 줄바꿈 없이 Secret Key를 입력하세요."

msgid "Enter a Turnstile Site Key."
msgstr "Turnstile Site Key를 입력하세요."

msgid "Enter a button label of up to 200 characters."
msgstr "버튼 문구는 200자 이내로 입력하세요."

msgid "Enter a description of up to 2,000 characters."
msgstr "설명은 2,000자 이내로 입력하세요."

