msgstr "WXR이 8 MiB를 초과하거나 전송 크기·서버 메모리상 필요하면 분할합니다. 기존 분할 형식은 유지합니다."

msgid "Static site URL"
msgstr "정적 사이트 URL"

msgid "Static site settings"
msgstr "정적 사이트 설정"

msgid "Subscribe"
msgstr "구독하기"

