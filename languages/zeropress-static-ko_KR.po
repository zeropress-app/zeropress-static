msgstr "GitHub를 일시적으로 사용할 수 없거나 요청 시간이 초과되었습니다."

msgid "GitHub publishing"
msgstr "GitHub 발행"

msgid "GitHub publishing (optional)"
msgstr "GitHub 발행 (선택)"

